                                    <!-- Zoom -->
                                    <Button x:Name="ZoomOutBtn" Content="-" Width="24" Height="24" Style="{StaticResource TabletBtnStyle}" Click="ZoomOutBtn_Click"/>
                                    <TextBlock x:Name="ZoomText" Text="100%" Foreground="#e2e8f0" VerticalAlignment="Center" HorizontalAlignment="Center" TextAlignment="Center" Width="36" FontSize="11"/>
                                    <Button x:Name="ZoomInBtn" Content="+" Width="24" Height="24" Style="{StaticResource TabletBtnStyle}" Margin="0,0,10,0" Click="ZoomInBtn_Click"/>

                                    <!-- Theme Toggle -->
                                    <Button x:Name="ThemeBtn" Content="📱 Ramă" Style="{StaticResource TabletBtnStyle}" Click="ThemeBtn_Click"/>
