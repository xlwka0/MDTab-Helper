                                        <GradientStop Color="#1e1b4b" Offset="0.5"/>
                                        <GradientStop Color="#311042" Offset="1.0"/>
                                    </LinearGradientBrush>
                                </Grid.Background>
                                
                                <Image x:Name="DesktopWallpaperImage" Stretch="UniformToFill"/>
                                
                                <!-- Apps Grid -->
                                <Grid Margin="30,20">
                                    <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Top">
                                        <!-- BiSyS App (MD Panel) -->
                                        <Button Style="{StaticResource DesktopAppButtonStyle}" Margin="20" Width="100" Height="110" Click="BrowserMdApp_Click">
                                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Border CornerRadius="16" Width="68" Height="68" ClipToBounds="True">
                                                    <Border.Effect>
                                                        <DropShadowEffect BlurRadius="12" Color="Black" Opacity="0.5" ShadowDepth="3"/>
                                                    </Border.Effect>
                                                    <Image Source="/Assets/icon_mdpanel.png" Stretch="UniformToFill"/>
                                                </Border>
                                                <TextBlock Text="BiSyS" Foreground="White" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,8,0,0" TextAlignment="Center">
                                                    <TextBlock.Effect>
                                                        <DropShadowEffect BlurRadius="4" Color="Black" Opacity="0.9" ShadowDepth="1"/>
                                                    </TextBlock.Effect>
                                                </TextBlock>
                                            </StackPanel>
                                        </Button>
                                        
                                        <!-- Panel App (gta5.ro) -->
                                        <Button Style="{StaticResource DesktopAppButtonStyle}" Margin="20" Width="100" Height="110" Click="RpgPanelApp_Click">
                                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Border CornerRadius="16" Width="68" Height="68" ClipToBounds="True">
                                                    <Border.Effect>
                                                        <DropShadowEffect BlurRadius="12" Color="Black" Opacity="0.5" ShadowDepth="3"/>
                                                    </Border.Effect>
                                                    <Image Source="/Assets/icon_panel.png" Stretch="UniformToFill"/>
                                                </Border>
                                                <TextBlock Text="Panel" Foreground="White" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,8,0,0" TextAlignment="Center">
                                                    <TextBlock.Effect>
                                                        <DropShadowEffect BlurRadius="4" Color="Black" Opacity="0.9" ShadowDepth="1"/>
                                                    </TextBlock.Effect>
                                                </TextBlock>
                                            </StackPanel>
                                        </Button>

                                        <!-- Portal MAI App (mai.b-zone.ro) -->
                                        <Button Style="{StaticResource DesktopAppButtonStyle}" Margin="20" Width="100" Height="110" Click="MaiApp_Click">
                                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Border CornerRadius="16" Width="68" Height="68" ClipToBounds="True">
                                                    <Border.Effect>
                                                        <DropShadowEffect BlurRadius="12" Color="Black" Opacity="0.5" ShadowDepth="3"/>
                                                    </Border.Effect>
                                                    <Image Source="/Assets/icon_mai.png" Stretch="UniformToFill"/>
                                                </Border>
                                                <TextBlock Text="Portal MAI" Foreground="White" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,8,0,0" TextAlignment="Center">
                                                    <TextBlock.Effect>
                                                        <DropShadowEffect BlurRadius="4" Color="Black" Opacity="0.9" ShadowDepth="1"/>
                                                    </TextBlock.Effect>
                                                </TextBlock>
                                            </StackPanel>
                                        </Button>

                                        <!-- Portal Primărie App (primarie.b-zone-business.ro) -->
                                        <Button Style="{StaticResource DesktopAppButtonStyle}" Margin="20" Width="100" Height="110" Click="PrimarieApp_Click">
                                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Border CornerRadius="16" Width="68" Height="68" ClipToBounds="True">
                                                    <Border.Effect>
                                                        <DropShadowEffect BlurRadius="12" Color="Black" Opacity="0.5" ShadowDepth="3"/>
                                                    </Border.Effect>
                                                    <Image Source="/Assets/icon_primarie.png" Stretch="UniformToFill"/>
                                                </Border>
                                                <TextBlock Text="Portal Primărie" Foreground="White" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,8,0,0" TextAlignment="Center">
                                                    <TextBlock.Effect>
                                                        <DropShadowEffect BlurRadius="4" Color="Black" Opacity="0.9" ShadowDepth="1"/>
                                                    </TextBlock.Effect>
                                                </TextBlock>
                                            </StackPanel>
                                        </Button>

                                        <!-- Portal Judecătorie App (judecatorie-b-zone.ro) -->
                                        <Button Style="{StaticResource DesktopAppButtonStyle}" Margin="20" Width="100" Height="110" Click="JudecatorieApp_Click">
                                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Border CornerRadius="16" Width="68" Height="68" ClipToBounds="True">
                                                    <Border.Effect>
                                                        <DropShadowEffect BlurRadius="12" Color="Black" Opacity="0.5" ShadowDepth="3"/>
                                                    </Border.Effect>
                                                    <Image Source="/Assets/icon_judecatorie.png" Stretch="UniformToFill"/>
                                                </Border>
                                                <TextBlock Text="Portal Judecătorie" Foreground="White" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,8,0,0" TextAlignment="Center">
                                                    <TextBlock.Effect>
                                                        <DropShadowEffect BlurRadius="4" Color="Black" Opacity="0.9" ShadowDepth="1"/>
                                                    </TextBlock.Effect>
                                                </TextBlock>
                                            </StackPanel>
                                        </Button>
                                        
                                        <!-- Overlays Manager App -->
                                        <Button Style="{StaticResource DesktopAppButtonStyle}" Margin="20" Width="100" Height="110" Click="OverlaysApp_Click">
                                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Border CornerRadius="16" Width="68" Height="68" ClipToBounds="True">
                                                    <Border.Effect>
                                                        <DropShadowEffect BlurRadius="12" Color="Black" Opacity="0.5" ShadowDepth="3"/>
                                                    </Border.Effect>
                                                    <Image Source="/Assets/icon_mdhelper.png" Stretch="UniformToFill"/>
                                                </Border>
                                                <TextBlock Text="Overlays" Foreground="White" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,8,0,0" TextAlignment="Center">
                                                    <TextBlock.Effect>
                                                        <DropShadowEffect BlurRadius="4" Color="Black" Opacity="0.9" ShadowDepth="1"/>
                                                    </TextBlock.Effect>
                                                </TextBlock>
                                            </StackPanel>
                                        </Button>

                                        <!-- Keybinds App -->
                                        <Button Style="{StaticResource DesktopAppButtonStyle}" Margin="20" Width="100" Height="110" Click="KeybindsApp_Click">
                                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Border CornerRadius="16" Width="68" Height="68" ClipToBounds="True">
                                                    <Border.Effect>
                                                        <DropShadowEffect BlurRadius="12" Color="Black" Opacity="0.5" ShadowDepth="3"/>
                                                    </Border.Effect>
                                                    <Image Source="/Assets/icon_mdhelper.png" Stretch="UniformToFill"/>
                                                </Border>
                                                <TextBlock Text="Keybinds" Foreground="White" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,8,0,0" TextAlignment="Center">
                                                    <TextBlock.Effect>
                                                        <DropShadowEffect BlurRadius="4" Color="Black" Opacity="0.9" ShadowDepth="1"/>
                                                    </TextBlock.Effect>
                                                </TextBlock>
                                            </StackPanel>
                                        </Button>

                                        <!-- Settings App -->
                                        <Button Style="{StaticResource DesktopAppButtonStyle}" Margin="20" Width="100" Height="110" Click="SettingsApp_Click">
                                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Border CornerRadius="16" Width="68" Height="68" ClipToBounds="True">
                                                    <Border.Effect>
                                                        <DropShadowEffect BlurRadius="12" Color="Black" Opacity="0.5" ShadowDepth="3"/>
                                                    </Border.Effect>
                                                    <Image Source="/Assets/icon_mdhelper.png" Stretch="UniformToFill"/>
                                                </Border>
                                                <TextBlock Text="Settings" Foreground="White" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,8,0,0" TextAlignment="Center">
                                                    <TextBlock.Effect>
                                                        <DropShadowEffect BlurRadius="4" Color="Black" Opacity="0.9" ShadowDepth="1"/>
                                                    </TextBlock.Effect>
                                                </TextBlock>
                                            </StackPanel>
                                        </Button>
                                    </WrapPanel>
                                </Grid>

                                <!-- Bottom Floating Dock -->
                                <Border VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,20" Height="80" Background="#44000000" BorderBrush="#15FFFFFF" BorderThickness="1" CornerRadius="20" Padding="15,5">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="15" Color="Black" Opacity="0.3" ShadowDepth="4"/>
                                    </Border.Effect>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Width="50" Height="50" Margin="8,0" Style="{x:Null}" Cursor="Hand" Click="BrowserMdApp_Click" ToolTip="BiSyS MD Panel">
                                            <Border CornerRadius="12" ClipToBounds="True">
                                                <Image Source="/Assets/icon_mdpanel.png" Stretch="UniformToFill"/>
                                            </Border>
                                        </Button>
                                        <Button Width="50" Height="50" Margin="8,0" Style="{x:Null}" Cursor="Hand" Click="OnDutyApp_Click" ToolTip="Medici la Datorie (Live)">
                                            <Border CornerRadius="12" ClipToBounds="True">
                                                <Image Source="/Assets/icon_duty.png" Stretch="UniformToFill"/>
                                            </Border>
                                        </Button>
                                        <Button Width="50" Height="50" Margin="8,0" Style="{x:Null}" Cursor="Hand" Click="RpgPanelApp_Click">
                                            <Border CornerRadius="12" ClipToBounds="True">
                                                <Image Source="/Assets/icon_panel.png" Stretch="UniformToFill"/>
                                            </Border>
                                        </Button>
                                        <Button Width="50" Height="50" Margin="8,0" Style="{x:Null}" Cursor="Hand" Click="OverlaysApp_Click">
                                            <Border CornerRadius="12" ClipToBounds="True">
                                                <Image Source="/Assets/icon_mdhelper.png" Stretch="UniformToFill"/>
                                            </Border>
                                        </Button>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- WEB TAB CONTENT -->
                            <Grid x:Name="WebTabContent" Visibility="Collapsed">
                                <!-- Fallback/Loading screen -->
                                <Border x:Name="LoadingIndicator" Background="#0b0f17" Panel.ZIndex="1" Visibility="Visible">
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <ProgressBar IsIndeterminate="True" Width="200" Height="4" Background="#0DFFFFFF" Foreground="#ff2d55" BorderThickness="0"/>
                                        <TextBlock Text="Se încarcă tableta..." Foreground="#94a3b8" FontSize="12" Margin="0,10,0,0" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <wv2:WebView2 x:Name="TabletWebView"/>
                            </Grid>

                            <!-- OVERLAYS TAB CONTENT -->
                            <Grid x:Name="OverlaysTabContent" Visibility="Collapsed" Background="#0f0f1a">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <!-- Header Area inside Overlays Tab -->
                                <Grid Grid.Row="0" Margin="20,20,20,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Overlays Controller" FontSize="22" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <Button x:Name="TabletAddImageBtn" Content="➕ Adaugă Imagine" Style="{StaticResource TabletBtnStyle}" Padding="12,6" Click="TabletAddImageBtn_Click" Margin="0,0,8,0"/>
                                        <Button x:Name="TabletToggleOverlaysBtn" Content="👁️ Afișează / Ascunde Overlays" Style="{StaticResource TabletBtnStyle}" Padding="12,6" Click="TabletToggleOverlaysBtn_Click"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Two-Column Content -->
                                <Grid Grid.Row="1" Margin="20,0,20,20">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.5*"/>
                                        <ColumnDefinition Width="20"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Left: Images List -->
                                    <Border Grid.Column="0" Background="#15152a" BorderBrush="#252540" BorderThickness="1" CornerRadius="12" Padding="15">
                                        <DataGrid x:Name="TabletImagesDataGrid"
                                                  AutoGenerateColumns="False"
                                                  CanUserAddRows="False"
                                                  CanUserDeleteRows="False"
                                                  GridLinesVisibility="None"
                                                  HeadersVisibility="Column"
                                                  Background="Transparent"
                                                  Foreground="White"
                                                  BorderThickness="0"
                                                  SelectionChanged="TabletImagesDataGrid_SelectionChanged"
                                                  Style="{StaticResource ModernDataGridStyle}">
                                            <DataGrid.ColumnHeaderStyle>
                                                <Style TargetType="DataGridColumnHeader">
                                                    <Setter Property="Background" Value="Transparent"/>
                                                    <Setter Property="Foreground" Value="#ccc"/>
                                                    <Setter Property="FontWeight" Value="Bold"/>
                                                    <Setter Property="FontSize" Value="13"/>
                                                    <Setter Property="Margin" Value="0,0,0,8"/>
                                                </Style>
                                            </DataGrid.ColumnHeaderStyle>
                                            <DataGrid.RowStyle>
                                                <Style TargetType="DataGridRow">
                                                    <Setter Property="Background" Value="Transparent"/>
                                                    <Setter Property="Foreground" Value="#ccc"/>
                                                    <Setter Property="FontSize" Value="12"/>
                                                    <Style.Triggers>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter Property="Background" Value="#4aff2d55"/>
                                                            <Setter Property="Foreground" Value="White"/>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </DataGrid.RowStyle>
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Nume" Binding="{Binding Name}" Width="*"/>
                                                <DataGridTextColumn Header="Mărime" Binding="{Binding SizeDisplay}" Width="100"/>
                                                <DataGridCheckBoxColumn Header="Locked" Binding="{Binding IsLocked}" Width="60"/>
                                                <DataGridCheckBoxColumn Header="Visible" Binding="{Binding IsVisible}" Width="60"/>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </Border>

                                    <!-- Right: Properties Panel -->
                                    <Border Grid.Column="2" Background="#15152a" BorderBrush="#252540" BorderThickness="1" CornerRadius="12" Padding="15">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                                            <StackPanel x:Name="TabletPropertiesPanel" IsEnabled="False">
                                                <TextBlock Text="Proprietăți Imagine" FontSize="16" FontWeight="Bold" Foreground="White" Margin="0,0,0,10"/>
                                                
                                                <TextBlock x:Name="TabletNoSelectionText" Text="Selectează o imagine din listă pentru a o edita" FontSize="12" Foreground="#888" Margin="0,0,0,10" TextWrapping="Wrap"/>

                                                <!-- Opacity -->
                                                <TextBlock Text="Opacitate" Foreground="#ccc" FontSize="13" FontWeight="Bold" Margin="0,0,0,3"/>
                                                <Grid Margin="0,0,0,10">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Slider x:Name="TabletImageOpacitySlider" Grid.Column="0" Minimum="0.1" Maximum="1.0" Value="1.0" TickFrequency="0.1" ValueChanged="TabletImageOpacitySlider_ValueChanged"/>
                                                    <TextBlock x:Name="TabletImageOpacityValueText" Grid.Column="1" Text="100%" Foreground="#ccc" FontSize="12" Margin="5,0,0,0" VerticalAlignment="Center"/>
                                                </Grid>

                                                <!-- Position -->
                                                <TextBlock Text="Poziție (X, Y)" Foreground="#ccc" FontSize="13" FontWeight="Bold" Margin="0,0,0,3"/>
                                                <Grid Margin="0,0,0,10">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="10"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBox x:Name="TabletPosXTextBox" Grid.Column="0" Text="0" Style="{StaticResource ModernTextBoxStyle}" TextChanged="TabletPositionTextBox_TextChanged"/>
                                                    <TextBox x:Name="TabletPosYTextBox" Grid.Column="2" Text="0" Style="{StaticResource ModernTextBoxStyle}" TextChanged="TabletPositionTextBox_TextChanged"/>
                                                </Grid>

                                                <!-- Size -->
                                                <TextBlock Text="Dimensiuni (Lățime, Înălțime)" Foreground="#ccc" FontSize="13" FontWeight="Bold" Margin="0,0,0,3"/>
                                                <Grid Margin="0,0,0,10">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="10"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBox x:Name="TabletImageWidthTextBox" Grid.Column="0" Text="100" Style="{StaticResource ModernTextBoxStyle}" TextChanged="TabletSizeTextBox_TextChanged"/>
                                                    <TextBox x:Name="TabletImageHeightTextBox" Grid.Column="2" Text="100" Style="{StaticResource ModernTextBoxStyle}" TextChanged="TabletSizeTextBox_TextChanged"/>
                                                </Grid>

                                                <!-- Checkboxes -->
                                                <CheckBox x:Name="TabletMaintainAspectCheckBox" Content="Menține aspect ratio" Foreground="#ccc" FontSize="12" Checked="TabletMaintainAspectCheckBox_Checked" Unchecked="TabletMaintainAspectCheckBox_Unchecked" Margin="0,0,0,8"/>
                                                <CheckBox x:Name="TabletLockedCheckBox" Content="Locked (Click-through)" Foreground="#ccc" FontSize="12" Checked="TabletLockedCheckBox_Checked" Unchecked="TabletLockedCheckBox_Unchecked" Margin="0,0,0,15"/>

                                                <!-- Delete Button -->
                                                <Button x:Name="TabletRemoveImageBtn" Content="🗑️ Șterge Imagine" Style="{StaticResource TabletBtnStyle}" Background="#2Aef4444" Click="TabletRemoveImageBtn_Click"/>
                                            </StackPanel>
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Grid>

                            <!-- KEYBINDS TAB CONTENT -->
                            <Grid x:Name="KeybindsTabContent" Visibility="Collapsed" Background="#0f0f1a">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <!-- Header Area -->
                                <Grid Grid.Row="0" Margin="20,20,20,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Keybinds Manager" FontSize="22" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <CheckBox x:Name="TabletGlobalKeybindsEnabledCheckBox" Content="Global Enabled" Foreground="#ccc" FontSize="13" VerticalAlignment="Center" Margin="0,0,15,0" Checked="TabletGlobalKeybinds_Checked" Unchecked="TabletGlobalKeybinds_Unchecked"/>
                                        <CheckBox x:Name="TabletGlobalSoundsEnabledCheckBox" Content="Enable Sounds" Foreground="#ccc" FontSize="13" VerticalAlignment="Center" Margin="0,0,15,0" Checked="TabletGlobalSounds_Checked" Unchecked="TabletGlobalSounds_Unchecked"/>
                                        <Button x:Name="TabletAddKeybindBtn" Content="➕ Adaugă Keybind" Style="{StaticResource TabletBtnStyle}" Padding="12,6" Click="TabletAddKeybindBtn_Click"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Two-Column Content -->
                                <Grid Grid.Row="1" Margin="20,0,20,20">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.5*"/>
                                        <ColumnDefinition Width="20"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Left: Keybinds List -->
                                    <Border Grid.Column="0" Background="#15152a" BorderBrush="#252540" BorderThickness="1" CornerRadius="12" Padding="15">
                                        <DataGrid x:Name="TabletKeybindsDataGrid"
                                                  AutoGenerateColumns="False"
                                                  CanUserAddRows="False"
                                                  CanUserDeleteRows="False"
                                                  GridLinesVisibility="None"
                                                  HeadersVisibility="Column"
                                                  Background="Transparent"
                                                  Foreground="White"
                                                  BorderThickness="0"
                                                  SelectionChanged="TabletKeybindsDataGrid_SelectionChanged"
                                                  Style="{StaticResource ModernDataGridStyle}">
                                            <DataGrid.ColumnHeaderStyle>
                                                <Style TargetType="DataGridColumnHeader">
                                                    <Setter Property="Background" Value="Transparent"/>
                                                    <Setter Property="Foreground" Value="#ccc"/>
                                                    <Setter Property="FontWeight" Value="Bold"/>
                                                    <Setter Property="FontSize" Value="13"/>
                                                    <Setter Property="Margin" Value="0,0,0,8"/>
                                                </Style>
                                            </DataGrid.ColumnHeaderStyle>
                                            <DataGrid.RowStyle>
                                                <Style TargetType="DataGridRow">
                                                    <Setter Property="Background" Value="Transparent"/>
                                                    <Setter Property="Foreground" Value="#ccc"/>
                                                    <Setter Property="FontSize" Value="12"/>
                                                    <Style.Triggers>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter Property="Background" Value="#4aff2d55"/>
                                                            <Setter Property="Foreground" Value="White"/>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </DataGrid.RowStyle>
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Nume" Binding="{Binding Name}" Width="*"/>
                                                <DataGridTextColumn Header="Tastă Trigger" Binding="{Binding KeyDisplay}" Width="120" IsReadOnly="True"/>
                                                <DataGridCheckBoxColumn Header="Activat" Binding="{Binding Enabled}" Width="60"/>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </Border>

                                    <!-- Right: Keybind Properties Panel & Delays -->
                                    <Border Grid.Column="2" Background="#15152a" BorderBrush="#252540" BorderThickness="1" CornerRadius="12" Padding="15">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                                            <StackPanel>
                                                <!-- Keybind Details -->
                                                <TextBlock Text="Proprietăți Keybind" FontSize="16" FontWeight="Bold" Foreground="White" Margin="0,0,0,10"/>
                                                
                                                <StackPanel x:Name="TabletKeybindPropertiesPanel" IsEnabled="False">
                                                    <TextBlock x:Name="TabletKeybindNoSelectionText" Text="Selectează un keybind din listă pentru a-l edita" FontSize="12" Foreground="#888" Margin="0,0,0,10" TextWrapping="Wrap"/>

                                                    <!-- Name -->
                                                    <TextBlock Text="Nume Keybind" Foreground="#ccc" FontSize="13" FontWeight="Bold" Margin="0,0,0,3"/>
                                                    <TextBox x:Name="TabletKeybindNameTextBox" Height="32" Style="{StaticResource ModernTextBoxStyle}" TextChanged="TabletKeybindNameTextBox_TextChanged" Margin="0,0,0,10"/>

                                                    <!-- Trigger Key -->
                                                    <TextBlock Text="Tastă Activare (Hotkey)" Foreground="#ccc" FontSize="13" FontWeight="Bold" Margin="0,0,0,3"/>
                                                    <Grid Margin="0,0,0,10">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Button x:Name="TabletRecordKeybindBtn" Grid.Column="0" Content="🔘 Set Key" Style="{StaticResource TabletBtnStyle}" Height="32" Padding="12,0" Click="TabletRecordKeybindBtn_Click"/>
                                                        <TextBlock x:Name="TabletKeybindKeyText" Grid.Column="1" Text="None" Foreground="#ff2d55" FontWeight="Bold" Margin="12,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                                    </Grid>

                                                    <!-- Script / Text -->
                                                    <TextBlock Text="Text / Comandă de trimis" Foreground="#ccc" FontSize="13" FontWeight="Bold" Margin="0,0,0,3"/>
                                                    <TextBox x:Name="TabletKeybindScriptTextBox" Height="60" AcceptsReturn="True" TextWrapping="Wrap" Style="{StaticResource ModernTextBoxStyle}" TextChanged="TabletKeybindScriptTextBox_TextChanged" Margin="0,0,0,10"/>

                                                    <!-- Enabled checkbox -->
                                                    <CheckBox x:Name="TabletKeybindEnabledCheckBox" Content="Keybind activat" Foreground="#ccc" FontSize="12" Checked="TabletKeybindEnabledCheckBox_Checked" Unchecked="TabletKeybindEnabledCheckBox_Unchecked" Margin="0,0,0,15"/>

                                                    <!-- Delete Button -->
                                                    <Button x:Name="TabletRemoveKeybindBtn" Content="🗑️ Șterge Keybind" Style="{StaticResource TabletBtnStyle}" Background="#2Aef4444" Click="TabletRemoveKeybindBtn_Click" Margin="0,0,0,20"/>
                                                </StackPanel>

                                                <Separator Background="#252540" Height="1" Margin="0,10,0,15"/>

                                                <!-- Delays Settings -->
                                                <TextBlock Text="Timpi de întârziere (Delays)" FontSize="16" FontWeight="Bold" Foreground="White" Margin="0,0,0,10"/>
                                                
                                                <TextBlock Text="Cooldown între comenzi (ms):" Foreground="#ccc" FontSize="12" Margin="0,0,0,3"/>
                                                <TextBox x:Name="TabletDelayMsTextBox" Height="32" Style="{StaticResource ModernTextBoxStyle}" TextChanged="TabletDelays_TextChanged" Margin="0,0,0,8"/>

                                                <TextBlock Text="Întârziere după deschidere Chat (ms):" Foreground="#ccc" FontSize="12" Margin="0,0,0,3"/>
                                                <TextBox x:Name="TabletDelayChatOpenMsTextBox" Height="32" Style="{StaticResource ModernTextBoxStyle}" TextChanged="TabletDelays_TextChanged" Margin="0,0,0,8"/>

                                                <TextBlock Text="Întârziere după scriere Text (ms):" Foreground="#ccc" FontSize="12" Margin="0,0,0,3"/>
                                                <TextBox x:Name="TabletDelayTextMsTextBox" Height="32" Style="{StaticResource ModernTextBoxStyle}" TextChanged="TabletDelays_TextChanged" Margin="0,0,0,8"/>

                                                <TextBlock Text="Întârziere după tasta Enter (ms):" Foreground="#ccc" FontSize="12" Margin="0,0,0,3"/>
                                                <TextBox x:Name="TabletDelayEnterMsTextBox" Height="32" Style="{StaticResource ModernTextBoxStyle}" TextChanged="TabletDelays_TextChanged" Margin="0,0,0,12"/>

                                                <!-- Stop Hotkey -->
                                                <Grid Margin="0,5,0,0">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="5"/>
                                                        <RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>
                                                    <CheckBox x:Name="TabletStopHotkeyEnabledCheckBox" Grid.Row="0" Content="Tastă Oprire Forțată (Stop Key)" Foreground="#ccc" FontSize="12" Checked="TabletStopHotkey_Checked" Unchecked="TabletStopHotkey_Unchecked"/>
                                                    <Grid Grid.Row="2" Margin="0,0,0,10">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Button x:Name="TabletRecordStopKeyBtn" Grid.Column="0" Content="🔘 Set Key" Style="{StaticResource TabletBtnStyle}" Height="32" Padding="12,0" Click="TabletRecordStopKeyBtn_Click"/>
                                                        <TextBlock x:Name="TabletStopKeyText" Grid.Column="1" Text="None" Foreground="#ff2d55" FontWeight="Bold" Margin="12,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                                    </Grid>
                                                </Grid>
                                            </StackPanel>
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Grid>

                            <!-- SETTINGS TAB CONTENT -->
                            <Grid x:Name="SettingsTabContent" Visibility="Collapsed" Background="#0f0f1a">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <!-- Header Area -->
                                <Grid Grid.Row="0" Margin="20,20,20,10">
                                    <TextBlock Text="System &amp; Display Settings" FontSize="22" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                                </Grid>

                                <!-- Content Scroll Panel -->
                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="20,0,20,20">
                                    <StackPanel>
                                        <!-- Card 1: Display Control Toggle -->
                                        <Border Background="#15152a" BorderBrush="#252540" BorderThickness="1" CornerRadius="12" Padding="20" Margin="0,0,0,15">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="12"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="12"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>

                                                <CheckBox x:Name="TabletWtEnabledCheckBox" Grid.Row="0" Content="Enable Display Control (Fereastră Target)" Foreground="White" FontSize="14" FontWeight="Bold" Checked="TabletWt_Checked" Unchecked="TabletWt_Unchecked"/>

                                                <Grid Grid.Row="2">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="15"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="20"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="10"/>
                                                        <ColumnDefinition Width="100"/>
                                                        <ColumnDefinition Width="10"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock Grid.Column="0" Text="Titlu Fereastră:" Foreground="#ccc" FontSize="13" VerticalAlignment="Center"/>
                                                    <ComboBox x:Name="TabletWtTitleComboBox" Grid.Column="2" Height="32" IsEditable="True" Style="{x:Null}" DropDownOpened="TabletWtTitleComboBox_DropDownOpened" SelectionChanged="TabletWtTitleComboBox_SelectionChanged" LostFocus="TabletWtTitleComboBox_LostFocus"/>

                                                    <TextBlock Grid.Column="4" Text="Tastă Toggle:" Foreground="#ccc" FontSize="13" VerticalAlignment="Center"/>
                                                    <Button x:Name="TabletRecordWtKeyBtn" Grid.Column="6" Content="🔴 Set Key" Height="32" Style="{StaticResource TabletBtnStyle}" Click="TabletRecordWtKeyBtn_Click"/>
                                                    <TextBlock x:Name="TabletWtKeyText" Grid.Column="8" Text="None" Foreground="#ff2d55" FontWeight="Bold" VerticalAlignment="Center"/>
                                                </Grid>

                                                <Grid Grid.Row="4">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="10"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="20"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="10"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="20"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="10"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="20"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="10"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock Grid.Column="0" Text="X:" Foreground="#ccc" VerticalAlignment="Center"/>
                                                    <TextBox x:Name="TabletWtXTextBox" Grid.Column="2" Height="32" Style="{StaticResource ModernTextBoxStyle}" TextChanged="TabletWtCoords_TextChanged"/>

                                                    <TextBlock Grid.Column="4" Text="Y:" Foreground="#ccc" VerticalAlignment="Center"/>
                                                    <TextBox x:Name="TabletWtYTextBox" Grid.Column="6" Height="32" Style="{StaticResource ModernTextBoxStyle}" TextChanged="TabletWtCoords_TextChanged"/>

                                                    <TextBlock Grid.Column="8" Text="Width:" Foreground="#ccc" VerticalAlignment="Center"/>
                                                    <TextBox x:Name="TabletWtWidthTextBox" Grid.Column="10" Height="32" Style="{StaticResource ModernTextBoxStyle}" TextChanged="TabletWtCoords_TextChanged"/>

                                                    <TextBlock Grid.Column="12" Text="Height:" Foreground="#ccc" VerticalAlignment="Center"/>
                                                    <TextBox x:Name="TabletWtHeightTextBox" Grid.Column="14" Height="32" Style="{StaticResource ModernTextBoxStyle}" TextChanged="TabletWtCoords_TextChanged"/>
                                                </Grid>
                                            </Grid>
                                        </Border>

                                        <!-- Card 2: Global Overlays Toggle Hotkey -->
                                        <Border Background="#15152a" BorderBrush="#252540" BorderThickness="1" CornerRadius="12" Padding="20" Margin="0,0,0,15">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="20"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="10"/>
                                                    <ColumnDefinition Width="100"/>
                                                    <ColumnDefinition Width="10"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <CheckBox x:Name="TabletOtEnabledCheckBox" Grid.Column="0" Content="Enable Overlay Toggle Hotkey" Foreground="White" FontSize="14" FontWeight="Bold" Checked="TabletOt_Checked" Unchecked="TabletOt_Unchecked"/>

                                                <TextBlock Grid.Column="2" Text="Hotkey:" Foreground="#ccc" FontSize="13" VerticalAlignment="Center"/>
                                                <Button x:Name="TabletRecordOtKeyBtn" Grid.Column="4" Content="🔴 Set Key" Height="32" Style="{StaticResource TabletBtnStyle}" Click="TabletRecordOtKeyBtn_Click"/>
                                                <TextBlock x:Name="TabletOtKeyText" Grid.Column="6" Text="None" Foreground="#ff2d55" FontWeight="Bold" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>

                                        <!-- Card 3: Windows Startup -->
                                        <Border Background="#15152a" BorderBrush="#252540" BorderThickness="1" CornerRadius="12" Padding="20" Margin="0,0,0,15">
                                            <Grid>
                                                <CheckBox x:Name="TabletStartWithWindowsCheckBox" Content="Start with Windows (Lansare automată la pornire PC)" Foreground="White" FontSize="14" FontWeight="Bold" Checked="TabletStartWithWindows_Checked" Unchecked="TabletStartWithWindows_Unchecked"/>
                                            </Grid>
                                        </Border>

                                        <!-- Card 4: Copilot settings -->
                                        <Border Background="#15152a" BorderBrush="#252540" BorderThickness="1" CornerRadius="12" Padding="20" Margin="0,0,0,15">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="12"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>

                                                <CheckBox x:Name="TabletCopilotEnabledCheckBox" Grid.Row="0" Content="Enable Copilot (Pilot Automat / Auto-Hold)" Foreground="White" FontSize="14" FontWeight="Bold" Checked="TabletCopilot_Checked" Unchecked="TabletCopilot_Unchecked"/>

                                                <Grid Grid.Row="2">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="10"/>
                                                        <ColumnDefinition Width="100"/>
                                                        <ColumnDefinition Width="15"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="25"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="10"/>
                                                        <ColumnDefinition Width="100"/>
                                                        <ColumnDefinition Width="15"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock Grid.Column="0" Text="Tasta de menținut:" Foreground="#ccc" FontSize="13" VerticalAlignment="Center"/>
                                                    <Button x:Name="TabletRecordCopilotKeyBtn" Grid.Column="2" Content="🔴 Set Key" Height="32" Style="{StaticResource TabletBtnStyle}" Click="TabletRecordCopilotKeyBtn_Click"/>
                                                    <TextBlock x:Name="TabletCopilotKeyText" Grid.Column="4" Text="W" Foreground="#ff2d55" FontWeight="Bold" VerticalAlignment="Center"/>

                                                    <TextBlock Grid.Column="6" Text="Tasta activatoare:" Foreground="#ccc" FontSize="13" VerticalAlignment="Center"/>
                                                    <Button x:Name="TabletRecordCopilotTriggerBtn" Grid.Column="8" Content="🔴 Set Key" Height="32" Style="{StaticResource TabletBtnStyle}" Click="TabletRecordCopilotTriggerBtn_Click"/>
                                                    <TextBlock x:Name="TabletCopilotTriggerText" Grid.Column="10" Text="Ctrl" Foreground="#ff2d55" FontWeight="Bold" VerticalAlignment="Center"/>
                                                </Grid>
                                            </Grid>
                                        </Border>

                                        <!-- Card 5: Wallpaper Settings -->
                                        <Border Background="#15152a" BorderBrush="#252540" BorderThickness="1" CornerRadius="12" Padding="20" Margin="0,0,0,15">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="15"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>

                                                <!-- Row 0: Desktop Wallpaper -->
                                                <Grid Grid.Row="0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="160"/>
                                                        <ColumnDefinition Width="10"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="10"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="Desktop Wallpaper:" Foreground="White" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                                                    <Button x:Name="TabletSelectWallpaperBtn" Grid.Column="2" Content="🖼️ Schimbă Wallpaper" Style="{StaticResource TabletBtnStyle}" Height="32" Padding="12,4" Click="TabletSelectWallpaperBtn_Click"/>
                                                    <Button x:Name="TabletResetWallpaperBtn" Grid.Column="4" Content="🔄 Resetează Wallpaper" Style="{StaticResource TabletBtnStyle}" Height="32" Padding="12,4" Click="TabletResetWallpaperBtn_Click" HorizontalAlignment="Left" Margin="10,0,0,0"/>
                                                </Grid>

                                                <!-- Row 2: Lockscreen Wallpaper -->
                                                <Grid Grid.Row="2">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="160"/>
                                                        <ColumnDefinition Width="10"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="10"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="Lockscreen Wallpaper:" Foreground="White" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                                                    <Button x:Name="TabletSelectLockWallpaperBtn" Grid.Column="2" Content="🔒 Schimbă Lockscreen" Style="{StaticResource TabletBtnStyle}" Height="32" Padding="12,4" Click="TabletSelectLockWallpaperBtn_Click"/>
                                                    <Button x:Name="TabletResetLockWallpaperBtn" Grid.Column="4" Content="🔄 Resetează Lockscreen" Style="{StaticResource TabletBtnStyle}" Height="32" Padding="12,4" Click="TabletResetLockWallpaperBtn_Click" HorizontalAlignment="Left" Margin="10,0,0,0"/>
                                                </Grid>
                                            </Grid>
                                        </Border>

                                        <!-- Card: Auto-Update & Version -->
                                        <Border Background="#161b26" CornerRadius="12" Padding="16" Margin="0,0,0,14" BorderBrush="#1FFFFFFF" BorderThickness="1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="🚀 Versiune &amp; Actualizări:" Foreground="White" FontSize="14" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                                    <Border CornerRadius="4" Background="#1A00E5FF" Padding="6,2" VerticalAlignment="Center" Margin="0,0,10,0">
                                                        <TextBlock x:Name="SettingsCurrentVersionText" Text="v2.5.0" Foreground="#00E5FF" FontSize="11" FontWeight="Bold"/>
                                                    </Border>
                                                    <TextBlock x:Name="SettingsUpdateStatusText" Text="Verificare actualizări la pornire..." Foreground="#64748B" FontSize="12" VerticalAlignment="Center"/>
                                                </StackPanel>

                                                <Button x:Name="SettingsCheckUpdateBtn" Grid.Column="2" Content="⟳ Verifică Actualizări" Style="{StaticResource TabletBtnStyle}" Height="32" Padding="12,4" Click="SettingsCheckUpdateBtn_Click" Cursor="Hand"/>
                                            </Grid>
                                        </Border>

                                        <!-- Card 5: Configuration Actions -->
                                        <Border Background="#161b26" CornerRadius="12" Padding="16" Margin="0,0,0,14" BorderBrush="#1FFFFFFF" BorderThickness="1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="20"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="10"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="20"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Grid.Column="0" Text="Configurare &amp; Sunete:" Foreground="White" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                                                <Button x:Name="TabletImportConfigBtn" Grid.Column="2" Content="📥 Importă Config" Style="{StaticResource TabletBtnStyle}" Height="32" Padding="12,4" Click="TabletImportConfigBtn_Click"/>
                                                <Button x:Name="TabletExportConfigBtn" Grid.Column="4" Content="📤 Exportă Config" Style="{StaticResource TabletBtnStyle}" Height="32" Padding="12,4" Click="TabletExportConfigBtn_Click" Margin="10,0,0,0"/>
                                                <Button x:Name="TabletExitAppBtn" Grid.Column="6" Content="❌ Închide Aplicația" Style="{StaticResource TabletBtnStyle}" Height="32" Padding="12,4" Click="TabletExitAppBtn_Click" Margin="10,0,0,0" Background="#33ef4444" BorderBrush="#ef4444"/>
                                            </Grid>
                                        </Border>
                                    </StackPanel>
                                </ScrollViewer>
                            </Grid>
                        </Grid>

                        <!-- Update Dialog Modal (Appears over tablet screen when update badge or button is clicked) -->
                        <Grid x:Name="UpdateModalGrid" Grid.RowSpan="4" Panel.ZIndex="150" Visibility="Collapsed">
                            <!-- Dimmed background overlay -->
                            <Border Background="#E0070B14"/>

                            <!-- Modal Card -->
                            <Border HorizontalAlignment="Center" VerticalAlignment="Center" Width="480" Background="#111622" BorderBrush="#00E5FF" BorderThickness="1" CornerRadius="18" Padding="24" ClipToBounds="True">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="40" Color="Black" Opacity="0.9" ShadowDepth="10"/>
                                </Border.Effect>
                                <StackPanel>
                                    <!-- Header -->
                                    <Grid Margin="0,0,0,16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="🚀" FontSize="26" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="Actualizare Disponibilă" Foreground="White" FontSize="16" FontWeight="Bold"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                                <TextBlock Text="Versiune nouă: " Foreground="#94A3B8" FontSize="12"/>
                                                <TextBlock x:Name="UpdateModalVersionText" Text="v2.6.0" Foreground="#00E5FF" FontSize="12" FontWeight="Bold" Margin="0,0,6,0"/>
                                                <TextBlock x:Name="UpdateModalSizeText" Text="(~73 MB)" Foreground="#64748B" FontSize="11" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </StackPanel>
                                        <Button Grid.Column="2" Content="✕" Width="26" Height="26" Style="{StaticResource TabletBtnStyle}" Padding="0" Cursor="Hand" Click="CancelUpdateBtn_Click"/>
                                    </Grid>

                                    <!-- Changelog Header -->
                                    <TextBlock Text="Noutăți și modificări:" Foreground="#CBD5E1" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                    <Border Background="#090D15" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="8" Padding="12" Height="130" Margin="0,0,0,16">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                                            <TextBlock x:Name="UpdateChangelogText" Text="Se încarcă detaliile..." Foreground="#94A3B8" FontSize="11" TextWrapping="Wrap" LineHeight="16"/>
                                        </ScrollViewer>
                                    </Border>

                                    <!-- Progress section (hidden until download starts) -->
                                    <StackPanel x:Name="UpdateProgressPanel" Visibility="Collapsed" Margin="0,0,0,16">
                                        <ProgressBar x:Name="UpdateProgressBar" Height="8" Minimum="0" Maximum="100" Value="0" Background="#161F30" Foreground="#00E5FF" BorderThickness="0"/>
                                        <TextBlock x:Name="UpdateProgressStatusText" Text="Se descarcă: 0%..." Foreground="#00E5FF" FontSize="11" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                                    </StackPanel>

                                    <!-- Action buttons -->
                                    <Grid x:Name="UpdateActionButtonsGrid">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="10"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="UpdateHintText" Grid.Column="0" Text="Aplicația se va reporni automat după descărcare." Foreground="#64748B" FontSize="10" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                        <Button x:Name="CancelUpdateBtn" Grid.Column="1" Content="Mai târziu" Style="{StaticResource TabletBtnStyle}" Height="34" Padding="14,6" Cursor="Hand" Click="CancelUpdateBtn_Click"/>
                                        <Button x:Name="ConfirmUpdateBtn" Grid.Column="3" Content="⚡ Actualizează acum" Style="{StaticResource TabletBtnStyle}" Background="#00E5FF" Foreground="#090D15" FontWeight="Bold" Height="34" Padding="16,6" Cursor="Hand" Click="ConfirmUpdateBtn_Click"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Lockscreen Overlay (Spans entire screen inside ScreenBorder) -->
                        <Grid x:Name="LockscreenGrid" Grid.RowSpan="4" Panel.ZIndex="100" Visibility="Visible" MouseLeftButtonDown="LockscreenGrid_MouseLeftButtonDown">
                            <!-- Gradient background overlay fallback -->
                            <Border>
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#090d16" Offset="0.0"/>
                                        <GradientStop Color="#16133a" Offset="0.5"/>
                                        <GradientStop Color="#250932" Offset="1.0"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                            <!-- Selected wallpaper as lockscreen background -->
                            <Image x:Name="LockscreenWallpaperImage" Stretch="UniformToFill"/>
                            <!-- Dimmed overlay -->
                            <Border Background="#A50A0E17"/>
                            
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <!-- Clock -->
                                <TextBlock x:Name="LockscreenClockText" Text="12:45" Foreground="White" FontSize="72" FontWeight="Light" HorizontalAlignment="Center" Margin="0,0,0,5">
                                    <TextBlock.Effect>
                                        <DropShadowEffect BlurRadius="10" Color="Black" Opacity="0.5" ShadowDepth="2"/>
                                    </TextBlock.Effect>
                                </TextBlock>
                                <!-- Date -->
                                <TextBlock x:Name="LockscreenDateText" Text="Luni, 17 August" Foreground="#cbd5e1" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,120">
                                    <TextBlock.Effect>
                                        <DropShadowEffect BlurRadius="6" Color="Black" Opacity="0.5" ShadowDepth="1"/>
                                    </TextBlock.Effect>
                                </TextBlock>
                                
                                <!-- Status/Hint -->
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <TextBlock Text="🔓" FontSize="18" Foreground="#ff2d55" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Click pentru a debloca tableta" Foreground="White" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center">
                                        <TextBlock.Effect>
                                            <DropShadowEffect BlurRadius="6" Color="Black" Opacity="0.8" ShadowDepth="1"/>
                                        </TextBlock.Effect>
                                    </TextBlock>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                        
                        <!-- Row 3: Bottom Bezel Indicator (Click to Close/Hide) -->
                        <Border Grid.Row="3" x:Name="BottomBar" Height="16" Background="#0b0f17" CornerRadius="0,0,18,18">
                            <Border x:Name="HomeIndicator" Width="140" Height="5" CornerRadius="2.5" Background="#334155" HorizontalAlignment="Center" VerticalAlignment="Center" MouseLeftButtonDown="HomeIndicator_MouseLeftButtonDown">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#ff2d55"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                            </Border>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
