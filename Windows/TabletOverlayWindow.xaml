<Window x:Class="MDHelper.Windows.TabletOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="MDTab-Helper"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="True"
        ResizeMode="CanResize"
        Height="820"
        Width="1200">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="8" GlassFrameThickness="0" CornerRadius="0"/>
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <!-- Modern Scrollbar Style -->
        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent"/>
        </Style>

        <!-- Rounded Button Style -->
        <Style x:Key="TabletBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="#0DFFFFFF"/>
            <Setter Property="Foreground" Value="#e2e8f0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#25FFFFFF"/>
                                <Setter Property="Foreground" Value="#00E5FF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#35FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#475569"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Text Box Style -->
        <Style x:Key="UrlInputStyle" TargetType="TextBox">
            <Setter Property="Background" Value="#CC0A0E17"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#14FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="False" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#ff2d55"/>
                                <Setter Property="Background" Value="#F20F172A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern TextBox Style -->
        <Style x:Key="ModernTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="#1a1a2e"/>
            <Setter Property="BorderBrush" Value="#333333"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost" 
                                          Foreground="{TemplateBinding Foreground}"
                                          VerticalAlignment="Center"
                                          VerticalScrollBarVisibility="Disabled"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern DataGrid Style -->
        <Style x:Key="ModernDataGridStyle" TargetType="DataGrid">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="GridLinesVisibility" Value="None"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="RowBackground" Value="Transparent"/>
            <Setter Property="AlternatingRowBackground" Value="Transparent"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
            <Setter Property="SelectionMode" Value="Single"/>
        </Style>

        <!-- Segmented Tab Radio Style -->
        <Style x:Key="TabletTabRadioStyle" TargetType="RadioButton">
            <Setter Property="Background" Value="#0f172a"/>
            <Setter Property="Foreground" Value="#94a3b8"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,4"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Border" 
                                Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="6" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#ff2d55"/>
                                <Setter TargetName="Border" Property="BorderBrush" Value="#ff2d55"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="BorderBrush" Value="#ff2d55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Desktop App Button Style -->
        <Style x:Key="DesktopAppButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent">
                            <ContentPresenter x:Name="Presenter" RenderTransformOrigin="0.5,0.5">
                                <ContentPresenter.RenderTransform>
                                    <ScaleTransform ScaleX="1.0" ScaleY="1.0"/>
                                </ContentPresenter.RenderTransform>
                            </ContentPresenter>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Presenter" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="1.06" ScaleY="1.06"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="MainRootGrid" Margin="14">
        <Grid.ColumnDefinitions>
            <!-- Column 0: On-Duty Dispatch Sidebar (Fixed to left of tablet, in same window) -->
            <ColumnDefinition x:Name="DutySidebarCol" Width="0"/>
            <!-- Column 1: Bezel Border (Tablet Frame) -->
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- LIVE ON-DUTY SIDEBAR (Pops out to the left of the tablet) -->
        <Border Grid.Column="0" x:Name="DutySidebarBorder" 
                Visibility="Collapsed" 
                Width="298" 
                Margin="0,0,12,0" 
                Background="#10141D" 
                BorderBrush="#1EFFFFFF" 
                BorderThickness="1" 
                CornerRadius="24"
                ClipToBounds="True">
            <Border.Effect>
                <DropShadowEffect BlurRadius="30" Color="Black" Opacity="0.85" ShadowDepth="8"/>
            </Border.Effect>
            
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Sidebar Header: Title, Counts, Search, Collapse -->
                <Border Grid.Row="0" Background="#0E1422" BorderBrush="#1C2436" BorderThickness="0,0,0,1" Padding="14,12" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Row 0: Badge & Actions -->
                        <Grid Grid.Row="0" Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse Width="8" Height="8" Fill="#10B981" VerticalAlignment="Center" Margin="0,0,6,0">
                                    <Ellipse.Effect>
                                        <DropShadowEffect BlurRadius="6" Color="#10B981" ShadowDepth="0"/>
                                    </Ellipse.Effect>
                                </Ellipse>
                                <TextBlock Text="DISPATCH LIVE" Foreground="#00E5FF" FontSize="11" FontWeight="ExtraBold" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <Border CornerRadius="4" Background="#1AFF2D55" Padding="4,1">
                                    <TextBlock x:Name="DutySidebarTotalBadge" Text="(0)" Foreground="#FF2D55" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                                </Border>
                            </StackPanel>

                            <Button x:Name="DutyRefreshBtn" Grid.Column="1" Content="⟳" ToolTip="Actualizează dispeceratul" Width="28" Height="28" FontSize="13" Style="{StaticResource TabletBtnStyle}" Padding="0" Margin="0,0,6,0" Cursor="Hand" WindowChrome.IsHitTestVisibleInChrome="True" Click="DutyRefreshBtn_Click"/>
                            <Button x:Name="DutySidebarCollapseBtn" Grid.Column="2" Content="▶" ToolTip="Ascunde lista (colapsează spre tabletă)" Width="28" Height="28" FontSize="11" Style="{StaticResource TabletBtnStyle}" Padding="0" Cursor="Hand" WindowChrome.IsHitTestVisibleInChrome="True" Click="DutySidebarCollapseBtn_Click"/>
                        </Grid>

                        <!-- Row 1: Quick Search -->
                        <Border Grid.Row="1" Background="#161F30" BorderBrush="#253247" BorderThickness="1" CornerRadius="6" Padding="8,4">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="🔍" Foreground="#64748B" FontSize="11" VerticalAlignment="Center" Margin="2,0,6,0"/>
                                <TextBox x:Name="DutySearchTextBox" Grid.Column="1" Background="Transparent" Foreground="White" BorderThickness="0" FontSize="12" VerticalAlignment="Center" TextChanged="DutySearchTextBox_TextChanged" Padding="0,1"/>
                                <TextBlock x:Name="DutySearchPlaceholder" Grid.Column="1" Text="Caută medic, indicativ, CNP..." Foreground="#64748B" FontSize="12" VerticalAlignment="Center" IsHitTestVisible="False" Margin="2,0,0,0"/>
                                <Button x:Name="DutySearchClearBtn" Grid.Column="2" Content="✕" Width="16" Height="16" Background="Transparent" Foreground="#94A3B8" BorderThickness="0" Cursor="Hand" Visibility="Collapsed" Click="DutySearchClearBtn_Click"/>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                <!-- Sidebar Body: Doctors List or States -->
                <Grid Grid.Row="1">
                    <!-- Loading State -->
                    <Border x:Name="DutyLoadingIndicator" Background="#0C101A" Panel.ZIndex="10" Visibility="Collapsed">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <ProgressBar IsIndeterminate="True" Width="140" Height="3" Background="#161F30" Foreground="#00E5FF" BorderThickness="0"/>
                            <TextBlock Text="Sincronizare dispecerat..." Foreground="#94A3B8" FontSize="11" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Error State -->
                    <Border x:Name="DutyErrorState" Background="#0C101A" Panel.ZIndex="9" Visibility="Collapsed" Padding="14">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="⚠️" FontSize="26" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                            <TextBlock Text="Eroare sincronizare" Foreground="#EF4444" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                            <TextBlock x:Name="DutyErrorMessageText" Text="Nu s-a putut contacta serverul Discord." Foreground="#94A3B8" FontSize="11" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                            <Button Content="⟳ Reîncearcă" Style="{StaticResource TabletBtnStyle}" Background="#1F2937" Foreground="#00E5FF" BorderThickness="1" BorderBrush="#00E5FF" Padding="12,5" FontSize="11" HorizontalAlignment="Center" Click="DutyRefreshBtn_Click"/>
                        </StackPanel>
                    </Border>

                    <!-- Empty State -->
                    <Border x:Name="DutyEmptyState" Background="#0C101A" Panel.ZIndex="8" Visibility="Collapsed" Padding="14">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="🔍" FontSize="26" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                            <TextBlock Text="Niciun medic găsit" Foreground="#E2E8F0" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,2"/>
                            <TextBlock Text="Nu există cadre medicale active sau filtrate." Foreground="#64748B" FontSize="11" HorizontalAlignment="Center" TextAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Scrollable Duty Doctors List -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="10,10,8,12">
                        <ItemsControl x:Name="DutyGroupsItemsControl">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,0,14">
                                        <!-- Group Header: e.g. "DIRECTOR GENERAL · 2" -->
                                        <StackPanel Orientation="Horizontal" Margin="4,6,0,4">
                                            <TextBlock Text="{Binding GradUpper}" Foreground="{Binding GradColor}" FontSize="10" FontWeight="Bold"/>
                                            <TextBlock Text="  ·  " Foreground="#FF2D55" FontSize="10" FontWeight="Bold"/>
                                            <TextBlock Text="{Binding Count}" Foreground="#FF2D55" FontSize="10" FontWeight="Bold"/>
                                        </StackPanel>

                                        <!-- Doctor Rows List -->
                                        <ItemsControl ItemsSource="{Binding Doctors}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="Transparent" 
                                                            BorderBrush="#22202B" 
                                                            BorderThickness="0,0,0,1" 
                                                            Padding="4,6" 
                                                            CornerRadius="4" 
                                                            Tag="{Binding}">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>

                                                            <!-- Left: Dot + Name + CNP -->
                                                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                                <!-- Green Online Dot -->
                                                                <Ellipse Width="6" Height="6" Fill="#22C55E" VerticalAlignment="Center" Margin="2,0,8,0">
                                                                    <Ellipse.Effect>
                                                                        <DropShadowEffect BlurRadius="4" Color="#22C55E" ShadowDepth="0" Opacity="0.8"/>
                                                                    </Ellipse.Effect>
                                                                </Ellipse>

                                                                <!-- Doctor Name in bold white -->
                                                                <TextBlock Text="{Binding Nume}" Foreground="White" FontSize="12" FontWeight="Bold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="150"/>

                                                                <!-- CNP in parentheses -->
                                                                <TextBlock Text="{Binding Cnp, StringFormat=' ({0})'}" Foreground="#9E9EA7" FontSize="12" VerticalAlignment="Center" Margin="3,0,0,0"/>
                                                            </StackPanel>

                                                            <!-- Right: Callsign Badge (reddish style matching BiSyS) -->
                                                            <Border Grid.Column="1" Background="#2B0E14" BorderBrush="#880816" BorderThickness="1" CornerRadius="4" Padding="5,1" Margin="4,0,0,0" VerticalAlignment="Center" Visibility="{Binding HasIndicativVisibility}">
                                                                <TextBlock Text="{Binding Indicativ}" Foreground="#FF4D6D" FontSize="10" FontWeight="Bold" FontFamily="Consolas"/>
                                                            </Border>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- Toast Notification for Copied inside Sidebar -->
                    <Border x:Name="DutyCopyToastBorder" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,14" Background="#102A45" BorderBrush="#00E5FF" BorderThickness="1" CornerRadius="8" Padding="14,6" Visibility="Collapsed" Panel.ZIndex="100">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="12" Color="#00E5FF" Opacity="0.5" ShadowDepth="2"/>
                        </Border.Effect>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="✓ " Foreground="#00E5FF" FontWeight="Bold" FontSize="12"/>
                            <TextBlock x:Name="DutyCopyToastText" Text="Datele medicului au fost copiate!" Foreground="White" FontSize="11" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Sidebar Footer -->
                <Border Grid.Row="2" Background="#0A0E17" BorderBrush="#1C2436" BorderThickness="0,1,0,0" Padding="10,8">
                    <TextBlock x:Name="DutyLastUpdatedText" Text="Sincronizat: --:--:--" Foreground="#64748B" FontSize="10" HorizontalAlignment="Center"/>
                </Border>
            </Grid>
        </Border>

        <!-- Bezel Border (iPad Frame) -->
        <Border x:Name="BezelBorder" 
                Grid.Column="1"
                Background="#10141d" 
                BorderBrush="#1EFFFFFF" 
                BorderThickness="1" 
                CornerRadius="28">
            <Border.Effect>
                <DropShadowEffect BlurRadius="40" Color="Black" Opacity="0.85" ShadowDepth="10"/>
            </Border.Effect>
            
            <Grid>
                <!-- Hardware Notch (Cam/Mic) -->
                <StackPanel x:Name="HardwareNotch" 
                            Orientation="Horizontal" 
                            HorizontalAlignment="Center" 
                            VerticalAlignment="Top" 
                            Margin="0,4,0,0" 
                            Height="10">
                    <!-- Cam -->
                    <Border Width="8" Height="8" CornerRadius="4" Background="#020617" BorderBrush="#334155" BorderThickness="1.5" Margin="0,0,8,0">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="2" Color="#00d2ff" ShadowDepth="0" Opacity="0.8"/>
                        </Border.Effect>
                    </Border>
                    <!-- Mic -->
                    <Border Width="4" Height="4" CornerRadius="2" Background="#1e293b" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Inner Screen Container -->
                <Border x:Name="ScreenBorder" 
                        Background="#0b0f17" 
                        CornerRadius="18" 
                        Margin="12,14,12,18">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="40"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Row 0: Top Status Bar (Draggable) -->
                        <Border Grid.Row="0" x:Name="TitleBar" Background="#0f172a" CornerRadius="18,18,0,0" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                            <Grid Margin="12,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Left Badge -->
                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Ellipse Width="8" Height="8" Fill="#10b981" Margin="0,0,6,0">
                                        <Ellipse.Effect>
                                            <DropShadowEffect BlurRadius="6" Color="#10b981" ShadowDepth="0"/>
                                        </Ellipse.Effect>
                                    </Ellipse>
                                    <TextBlock Text="MDTab-Helper" Foreground="#f8fafc" FontSize="12" FontWeight="ExtraBold" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <Border CornerRadius="6" Background="#1A00D2FF" BorderBrush="#3300D2FF" BorderThickness="1" Padding="6,2" VerticalAlignment="Center" Margin="0,0,6,0">
                                        <TextBlock x:Name="TabletVersionText" Text="v2.5.3" Foreground="#00d2ff" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                    </Border>
                                    <Button x:Name="TabletUpdateBadgeBtn" Content="⚡ Update vX.X" ToolTip="O nouă versiune este disponibilă! Click pentru detalii." Style="{StaticResource TabletBtnStyle}" Background="#1A00D2FF" Foreground="#00d2ff" BorderBrush="#00d2ff" BorderThickness="1" FontSize="10" FontWeight="Bold" Padding="8,2" Margin="4,0,0,0" Height="22" Cursor="Hand" Visibility="Collapsed" Click="TabletUpdateBadgeBtn_Click" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="ClockText" Text="00:00:00" Foreground="#94a3b8" FontSize="11" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center" FontFamily="Consolas"/>
                                </StackPanel>

                                <!-- Center Lock Button -->
                                <Button x:Name="TabletLockBtn" Grid.Column="1" Content="🔒 Lock Screen" Style="{StaticResource TabletBtnStyle}" Height="28" Padding="12,3" FontSize="11" FontWeight="Bold" Click="TabletLockBtn_Click" VerticalAlignment="Center"/>

                                <!-- Right Controls -->
                                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <!-- Duty Sidebar Toggle Button -->
                                    <Button x:Name="DutyTitleBarToggleBtn" Content="👥 Medici Duty" Style="{StaticResource TabletBtnStyle}" Height="28" Padding="10,2" FontSize="11" FontWeight="Bold" Margin="0,0,10,0" Click="DutySidebarToggle_Click" ToolTip="Comută afișarea listei laterale de Medici la Datorie"/>
                                    <!-- Network Status -->
                                    <TextBlock Text="5G MD" Foreground="#94a3b8" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Text="⚡ 100%" Foreground="#10b981" FontSize="11" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    <!-- Window Control buttons -->
                                    <Button Content="—" Width="24" Height="24" Background="Transparent" Foreground="#e2e8f0" BorderThickness="0" Margin="0,0,4,0" Focusable="False" Cursor="Hand" WindowChrome.IsHitTestVisibleInChrome="True" Click="MinimizeBtn_Click"/>
                                    <Button Content="✕" Width="24" Height="24" Background="Transparent" Foreground="#ef4444" BorderThickness="0" Focusable="False" Cursor="Hand" WindowChrome.IsHitTestVisibleInChrome="True" Click="CloseBtn_Click"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Row 1: Nav Toolbar -->
                        <Border Grid.Row="1" x:Name="NavToolbarBorder" Background="#F2121826" BorderBrush="#0FFFFFFF" BorderThickness="0,0,0,1" Padding="12,8" Visibility="Collapsed">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Column 0: Browser Nav Buttons -->
                                <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="0,0,10,0">
                                    <Button x:Name="BackBtn" Content="◀" Width="32" Height="32" Style="{StaticResource TabletBtnStyle}" Margin="0,0,4,0" Click="BackBtn_Click"/>
                                    <Button x:Name="ForwardBtn" Content="▶" Width="32" Height="32" Style="{StaticResource TabletBtnStyle}" Margin="0,0,4,0" Click="ForwardBtn_Click"/>
                                    <Button x:Name="ReloadBtn" Content="⟳" Width="32" Height="32" Style="{StaticResource TabletBtnStyle}" Margin="0,0,4,0" Click="ReloadBtn_Click"/>
                                    <Button x:Name="HomeBtn" Content="🏠" Width="32" Height="32" Style="{StaticResource TabletBtnStyle}" Click="HomeBtn_Click"/>
                                </StackPanel>

                                <!-- Column 1: URL input -->
                                <Grid Grid.Column="1" Margin="0,0,10,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="UrlTextBox" Grid.Column="0" Text="https://md.b-zone.ro" Style="{StaticResource UrlInputStyle}" KeyDown="UrlTextBox_KeyDown"/>
                                    <Button x:Name="GoBtn" Grid.Column="1" Content="➔" Width="32" Height="32" Margin="4,0,0,0" Style="{StaticResource TabletBtnStyle}" Click="GoBtn_Click"/>
                                </Grid>

                                <!-- Column 2: Quick Bookmarks -->
                                <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="0,0,10,0">
                                    <Button x:Name="MdPanelBtn" Content="BiSyS" Style="{StaticResource TabletBtnStyle}" Margin="0,0,4,0" Click="MdPanelBtn_Click"/>
                                    <Button x:Name="GtaPanelBtn" Content="Panel" Style="{StaticResource TabletBtnStyle}" Click="GtaPanelBtn_Click"/>
                                </StackPanel>

                                <!-- Column 3: Tools (Opacity, Zoom, Theme) -->
                                <StackPanel Grid.Column="3" Orientation="Horizontal">
                                    <!-- Opacity -->
                                    <TextBlock Text="🌓" Foreground="#94a3b8" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                    <Slider x:Name="OpacitySlider" Width="70" Minimum="0.5" Maximum="1.0" Value="0.96" VerticalAlignment="Center" Margin="0,0,4,0" ValueChanged="OpacitySlider_ValueChanged"/>
