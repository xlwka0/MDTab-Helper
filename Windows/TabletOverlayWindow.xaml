<Window x:Class="MDHelper.Windows.TabletOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="MDTab-Helper"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="True"
        ResizeMode="CanResize"
        Height="820"
        Width="1200">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="8" GlassFrameThickness="0" CornerRadius="0"/>
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <!-- Modern Scrollbar Style -->
        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent"/>
        </Style>

        <!-- Rounded Button Style -->
        <Style x:Key="TabletBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="#0DFFFFFF"/>
            <Setter Property="Foreground" Value="#e2e8f0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#25FFFFFF"/>
                                <Setter Property="Foreground" Value="#00E5FF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#35FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#475569"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Text Box Style -->
        <Style x:Key="UrlInputStyle" TargetType="TextBox">
            <Setter Property="Background" Value="#CC0A0E17"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#14FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="False" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#ff2d55"/>
                                <Setter Property="Background" Value="#F20F172A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern TextBox Style -->
        <Style x:Key="ModernTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="#1a1a2e"/>
            <Setter Property="BorderBrush" Value="#333333"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost" 
                                          Foreground="{TemplateBinding Foreground}"
                                          VerticalAlignment="Center"
                                          VerticalScrollBarVisibility="Disabled"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern DataGrid Style -->
        <Style x:Key="ModernDataGridStyle" TargetType="DataGrid">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="GridLinesVisibility" Value="None"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="RowBackground" Value="Transparent"/>
            <Setter Property="AlternatingRowBackground" Value="Transparent"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
            <Setter Property="SelectionMode" Value="Single"/>
        </Style>

        <!-- Segmented Tab Radio Style -->
        <Style x:Key="TabletTabRadioStyle" TargetType="RadioButton">
            <Setter Property="Background" Value="#0f172a"/>
            <Setter Property="Foreground" Value="#94a3b8"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,4"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Border" 
                                Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="6" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#ff2d55"/>
                                <Setter TargetName="Border" Property="BorderBrush" Value="#ff2d55"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="BorderBrush" Value="#ff2d55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Desktop App Button Style -->
        <Style x:Key="DesktopAppButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent">
                            <ContentPresenter x:Name="Presenter" RenderTransformOrigin="0.5,0.5">
                                <ContentPresenter.RenderTransform>
                                    <ScaleTransform ScaleX="1.0" ScaleY="1.0"/>
                                </ContentPresenter.RenderTransform>
                            </ContentPresenter>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Presenter" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="1.06" ScaleY="1.06"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="MainRootGrid" Margin="14">
        <Grid.ColumnDefinitions>
            <!-- Column 0: On-Duty Dispatch Sidebar (Fixed to left of tablet, in same window) -->
            <ColumnDefinition x:Name="DutySidebarCol" Width="0"/>
            <!-- Column 1: Bezel Border (Tablet Frame) -->
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- LIVE ON-DUTY & BANDAGES SIDEBAR (Pops out to the left of the tablet) -->
        <Border Grid.Column="0" x:Name="DutySidebarBorder" 
                Visibility="Collapsed" 
                Width="345" 
                Margin="0,0,15,0" 
                Background="Transparent" 
                BorderThickness="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- TOP CARD: LIVE BANDAGES STOCK (Above On-Duty) -->
                <Border Grid.Row="0"
                        Margin="0,0,0,12"
                        Background="#10141D"
                        BorderBrush="#1EFFFFFF"
                        BorderThickness="1"
                        CornerRadius="18"
                        Padding="14,12"
                        ClipToBounds="True"
                        MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="25" Color="Black" Opacity="0.85" ShadowDepth="6"/>
                    </Border.Effect>
                    <Grid>
                        <Grid x:Name="BandagesActiveContentGrid" Visibility="Visible">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse Width="8" Height="8" Fill="#10B981" VerticalAlignment="Center" Margin="0,0,6,0">
                                    <Ellipse.Effect>
                                        <DropShadowEffect BlurRadius="6" Color="#10B981" ShadowDepth="0"/>
                                    </Ellipse.Effect>
                                </Ellipse>
                                <TextBlock Text="BANDAJE DISPONIBILE" Foreground="#00E5FF" FontSize="11" FontWeight="ExtraBold" VerticalAlignment="Center"/>
                            </StackPanel>
                            <Border Grid.Column="1" CornerRadius="6" Background="#161F30" BorderBrush="#253247" BorderThickness="1" Padding="10,4" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Viewbox Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center">
                                        <Canvas Width="24" Height="24">
                                            <Path Data="M11,21.73 a2,2 0 0 0 2,0 l7,-4 A2,2 0 0 0 21,16 V8 a2,2 0 0 0 -1,-1.73 l-7,-4 a2,2 0 0 0 -2,0 l-7,4 A2,2 0 0 0 3,8 v8 a2,2 0 0 0 1,1.73 z" Stroke="#10B981" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                                            <Path Data="M12,22 V12" Stroke="#10B981" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                            <Polyline Points="3.29,7 12,12 20.71,7" Stroke="#10B981" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                                            <Path Data="M7.5,4.27 L16.5,9.42" Stroke="#10B981" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                        </Canvas>
                                    </Viewbox>
                                    <TextBlock x:Name="BandagesCountText" Text="--" Foreground="White" FontSize="14" FontWeight="ExtraBold" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <StackPanel x:Name="BandagesGameOfflineState" Visibility="Collapsed" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="BANDAJE DISPONIBILE · " Foreground="#64748B" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                            <TextBlock Text="Neconectat" Foreground="#94A3B8" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- BOTTOM CARD: LIVE ON-DUTY DISPATCH -->
                <Border Grid.Row="1"
                        Background="#10141D" 
                        BorderBrush="#1EFFFFFF" 
                        BorderThickness="1" 
                        CornerRadius="24"
                        ClipToBounds="True">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="30" Color="Black" Opacity="0.85" ShadowDepth="8"/>
                    </Border.Effect>
                    
                    <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Sidebar Header: Title, Counts, Search, Collapse -->
                <Border Grid.Row="0" Background="#0E1422" BorderBrush="#1C2436" BorderThickness="0,0,0,1" Padding="14,12" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Row 0: Badge & Actions -->
                        <Grid Grid.Row="0" Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse Width="8" Height="8" Fill="#10B981" VerticalAlignment="Center" Margin="0,0,6,0">
                                    <Ellipse.Effect>
                                        <DropShadowEffect BlurRadius="6" Color="#10B981" ShadowDepth="0"/>
                                    </Ellipse.Effect>
                                </Ellipse>
                                <TextBlock Text="DISPATCH LIVE" Foreground="#00E5FF" FontSize="11" FontWeight="ExtraBold" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <Border CornerRadius="4" Background="#1AFF2D55" Padding="4,1">
                                    <TextBlock x:Name="DutySidebarTotalBadge" Text="(0)" Foreground="#FF2D55" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                                </Border>
                            </StackPanel>

                            <Button x:Name="DutyRefreshBtn" Grid.Column="1" Content="⟳" ToolTip="Actualizează dispeceratul" Width="28" Height="28" FontSize="13" Style="{StaticResource TabletBtnStyle}" Padding="0" Margin="0,0,6,0" Cursor="Hand" WindowChrome.IsHitTestVisibleInChrome="True" Click="DutyRefreshBtn_Click"/>
                            <Button x:Name="DutySidebarCollapseBtn" Grid.Column="2" Content="▶" ToolTip="Ascunde lista (colapsează spre tabletă)" Width="28" Height="28" FontSize="11" Style="{StaticResource TabletBtnStyle}" Padding="0" Cursor="Hand" WindowChrome.IsHitTestVisibleInChrome="True" Click="DutySidebarCollapseBtn_Click"/>
                        </Grid>

                        <!-- Row 1: Quick Search -->
                        <Border Grid.Row="1" Background="#161F30" BorderBrush="#253247" BorderThickness="1" CornerRadius="6" Padding="8,4">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="🔍" Foreground="#64748B" FontSize="11" VerticalAlignment="Center" Margin="2,0,6,0"/>
                                <TextBox x:Name="DutySearchTextBox" Grid.Column="1" Background="Transparent" Foreground="White" BorderThickness="0" FontSize="12" VerticalAlignment="Center" TextChanged="DutySearchTextBox_TextChanged" Padding="0,1"/>
                                <TextBlock x:Name="DutySearchPlaceholder" Grid.Column="1" Text="Caută medic, indicativ, CNP..." Foreground="#64748B" FontSize="12" VerticalAlignment="Center" IsHitTestVisible="False" Margin="2,0,0,0"/>
                                <Button x:Name="DutySearchClearBtn" Grid.Column="2" Content="✕" Width="16" Height="16" Background="Transparent" Foreground="#94A3B8" BorderThickness="0" Cursor="Hand" Visibility="Collapsed" Click="DutySearchClearBtn_Click"/>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                <!-- Sidebar Body: Doctors List or States -->
                <Grid Grid.Row="1">
                    <!-- Portal Offline / Disconnected State -->
                    <Border x:Name="DutyGameOfflineState" Background="#0C101A" Panel.ZIndex="12" Visibility="Collapsed" Padding="20,24">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Border Width="46" Height="46" CornerRadius="23" Background="#162235" BorderBrush="#00E5FF" BorderThickness="1" Margin="0,0,0,12" HorizontalAlignment="Center">
                                <TextBlock Text="⚡" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock x:Name="DutyOfflineTitleText" Text="Sincronizare Portal MD" Foreground="#F1F5F9" FontSize="17" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                            <TextBlock x:Name="DutyOfflineDescText" Text="Pentru a vedea medicii activi pe tură și stocul de bandaje, este necesară autorizarea sincronizării cu portalul." Foreground="#CBD5E1" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="290" Margin="0,0,0,14"/>

                            <!-- Activation / Action Button -->
                            <Button x:Name="DutyActivateSyncBtn" Content="⚡ Activează Sincronizarea" Background="#00E5FF" Foreground="#0A0E17" FontWeight="Bold" FontSize="12" Padding="18,7" BorderThickness="0" Cursor="Hand" Click="DutyActivateSyncBtn_Click" HorizontalAlignment="Center" Margin="0,0,0,10">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="8"/>
                                    </Style>
                                </Button.Resources>
                            </Button>

                            <TextBlock x:Name="DutyOfflineSubtext" Text="Apasă pe butonul de mai sus pentru detalii și activare." Foreground="#64748B" FontSize="11" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="280"/>
                        </StackPanel>
                    </Border>

                    <!-- Loading State -->
                    <Border x:Name="DutyLoadingIndicator" Background="#0C101A" Panel.ZIndex="10" Visibility="Collapsed">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <ProgressBar IsIndeterminate="True" Width="140" Height="3" Background="#161F30" Foreground="#00E5FF" BorderThickness="0"/>
                            <TextBlock Text="Sincronizare dispecerat..." Foreground="#94A3B8" FontSize="11" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Error State -->
                    <Border x:Name="DutyErrorState" Background="#0C101A" Panel.ZIndex="9" Visibility="Collapsed" Padding="14">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="⚠️" FontSize="26" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                            <TextBlock Text="Eroare sincronizare" Foreground="#EF4444" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                            <TextBlock x:Name="DutyErrorMessageText" Text="Nu s-a putut contacta serverul Discord." Foreground="#94A3B8" FontSize="11" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                            <Button Content="⟳ Reîncearcă" Style="{StaticResource TabletBtnStyle}" Background="#1F2937" Foreground="#00E5FF" BorderThickness="1" BorderBrush="#00E5FF" Padding="12,5" FontSize="11" HorizontalAlignment="Center" Click="DutyRefreshBtn_Click"/>
                        </StackPanel>
                    </Border>

                    <!-- Empty State -->
                    <Border x:Name="DutyEmptyState" Background="#0C101A" Panel.ZIndex="8" Visibility="Collapsed" Padding="14">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="🔍" FontSize="26" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                            <TextBlock Text="Niciun medic găsit" Foreground="#E2E8F0" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,2"/>
                            <TextBlock Text="Nu există cadre medicale active sau filtrate." Foreground="#64748B" FontSize="11" HorizontalAlignment="Center" TextAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Scrollable Duty Doctors List -->
                    <ScrollViewer VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled" Padding="12,10,12,12">
                        <ItemsControl x:Name="DutyGroupsItemsControl">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,0,14">
                                        <!-- Group Header: e.g. "DIRECTOR GENERAL · 2" -->
                                        <StackPanel Orientation="Horizontal" Margin="4,6,0,4">
                                            <TextBlock Text="{Binding GradUpper}" Foreground="{Binding GradColor}" FontSize="10" FontWeight="Bold"/>
                                            <TextBlock Text="  ·  " Foreground="#FF2D55" FontSize="10" FontWeight="Bold"/>
                                            <TextBlock Text="{Binding Count}" Foreground="#FF2D55" FontSize="10" FontWeight="Bold"/>
                                        </StackPanel>

                                        <!-- Doctor Rows List -->
                                        <ItemsControl ItemsSource="{Binding Doctors}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="Transparent" 
                                                            BorderBrush="#22202B" 
                                                            BorderThickness="0,0,0,1" 
                                                            Padding="4,6" 
                                                            CornerRadius="4" 
                                                            Cursor="Hand"
                                                            MouseLeftButtonUp="DutyDoctorRow_MouseLeftButtonUp"
                                                            Tag="{Binding}">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>

                                                            <!-- Left: Dot + Name + CNP -->
                                                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                                <!-- Green Online Dot -->
                                                                <Ellipse Width="6" Height="6" Fill="#22C55E" VerticalAlignment="Center" Margin="2,0,8,0">
                                                                    <Ellipse.Effect>
                                                                        <DropShadowEffect BlurRadius="4" Color="#22C55E" ShadowDepth="0" Opacity="0.8"/>
                                                                    </Ellipse.Effect>
                                                                </Ellipse>

                                                                <!-- Doctor Name in bold white -->
                                                                <TextBlock Text="{Binding Nume}" Foreground="White" FontSize="12" FontWeight="Bold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="180"/>

                                                                <!-- CNP in parentheses -->
                                                                <TextBlock Text="{Binding Cnp, StringFormat=' ({0})'}" Foreground="#9E9EA7" FontSize="12" VerticalAlignment="Center" Margin="3,0,0,0"/>
                                                            </StackPanel>

                                                            <!-- Right: Callsign Badge (reddish style matching BiSyS) -->
                                                            <Border Grid.Column="1" Background="#2B0E14" BorderBrush="#880816" BorderThickness="1" CornerRadius="4" Padding="5,1" Margin="4,0,0,0" VerticalAlignment="Center" Visibility="{Binding HasIndicativVisibility}">
                                                                <TextBlock Text="{Binding Indicativ}" Foreground="#FF4D6D" FontSize="10" FontWeight="Bold" FontFamily="Consolas"/>
                                                            </Border>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- Toast Notification for Copied inside Sidebar -->
                    <Border x:Name="DutyCopyToastBorder" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,14" Background="#102A45" BorderBrush="#00E5FF" BorderThickness="1" CornerRadius="8" Padding="14,6" Visibility="Collapsed" Panel.ZIndex="100">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="12" Color="#00E5FF" Opacity="0.5" ShadowDepth="2"/>
                        </Border.Effect>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="✓ " Foreground="#00E5FF" FontWeight="Bold" FontSize="12"/>
                            <TextBlock x:Name="DutyCopyToastText" Text="Datele medicului au fost copiate!" Foreground="White" FontSize="11" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Border>
                </Grid>

                        <!-- Sidebar Footer -->
                        <Border Grid.Row="2" Background="#0A0E17" BorderBrush="#1C2436" BorderThickness="0,1,0,0" Padding="10,8">
                            <TextBlock x:Name="DutyLastUpdatedText" Text="Sincronizat: --:--:--" Foreground="#64748B" FontSize="10" HorizontalAlignment="Center"/>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- Bezel Border (iPad Frame) -->
        <Border x:Name="BezelBorder" 
                Grid.Column="1"
                Background="#10141d" 
                BorderBrush="#1EFFFFFF" 
                BorderThickness="1" 
                CornerRadius="28">
            <Border.Effect>
                <DropShadowEffect BlurRadius="40" Color="Black" Opacity="0.85" ShadowDepth="10"/>
            </Border.Effect>
            
            <Grid>
                <!-- Hardware Notch (Cam/Mic) -->
                <StackPanel x:Name="HardwareNotch" 
                            Orientation="Horizontal" 
                            HorizontalAlignment="Center" 
                            VerticalAlignment="Top" 
                            Margin="0,4,0,0" 
                            Height="10">
                    <!-- Cam -->
                    <Border Width="8" Height="8" CornerRadius="4" Background="#020617" BorderBrush="#334155" BorderThickness="1.5" Margin="0,0,8,0">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="2" Color="#00d2ff" ShadowDepth="0" Opacity="0.8"/>
                        </Border.Effect>
                    </Border>
                    <!-- Mic -->
                    <Border Width="4" Height="4" CornerRadius="2" Background="#1e293b" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Inner Screen Container -->
                <Border x:Name="ScreenBorder" 
                        Background="#0b0f17" 
                        CornerRadius="18" 
                        Margin="12,14,12,18">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="40"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Row 0: Top Status Bar (Draggable) -->
                        <Border Grid.Row="0" x:Name="TitleBar" Background="#0f172a" CornerRadius="18,18,0,0" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                            <Grid Margin="12,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Left Badge -->
                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Ellipse Width="8" Height="8" Fill="#10b981" Margin="0,0,6,0">
                                        <Ellipse.Effect>
                                            <DropShadowEffect BlurRadius="6" Color="#10b981" ShadowDepth="0"/>
                                        </Ellipse.Effect>
                                    </Ellipse>
                                    <TextBlock Text="MDTab-Helper" Foreground="#f8fafc" FontSize="12" FontWeight="ExtraBold" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <Border CornerRadius="6" Background="#1A00D2FF" BorderBrush="#3300D2FF" BorderThickness="1" Padding="6,2" VerticalAlignment="Center" Margin="0,0,6,0">
                                        <TextBlock x:Name="TabletVersionText" Text="v2.7.4" Foreground="#00d2ff" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                    </Border>
                                    <Button x:Name="TabletUpdateBadgeBtn" Content="⚡ Update vX.X" ToolTip="O nouă versiune este disponibilă! Click pentru detalii." Style="{StaticResource TabletBtnStyle}" Background="#1A00D2FF" Foreground="#00d2ff" BorderBrush="#00d2ff" BorderThickness="1" FontSize="10" FontWeight="Bold" Padding="8,2" Margin="4,0,0,0" Height="22" Cursor="Hand" Visibility="Collapsed" Click="TabletUpdateBadgeBtn_Click" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="ClockText" Text="00:00:00" Foreground="#94a3b8" FontSize="11" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center" FontFamily="Consolas"/>
                                    <Button x:Name="TitleBarHomeBtn" Content="🏠 Acasă" ToolTip="Înapoi la ecranul principal (Desktop)" Style="{StaticResource TabletBtnStyle}" Background="#1E293B" Foreground="#00E5FF" BorderBrush="#334155" BorderThickness="1" Height="26" Padding="8,2" FontSize="11" FontWeight="Bold" Margin="10,0,0,0" Cursor="Hand" Click="HomeBtn_Click" Visibility="Collapsed" VerticalAlignment="Center"/>
                                </StackPanel>

                                <!-- Center Lock Button -->
                                <Button x:Name="TabletLockBtn" Grid.Column="1" Content="🔒 Lock Screen" Style="{StaticResource TabletBtnStyle}" Height="28" Padding="12,3" FontSize="11" FontWeight="Bold" Click="TabletLockBtn_Click" VerticalAlignment="Center"/>

                                <!-- Right Controls -->
                                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <!-- Duty Sidebar Toggle Button -->
                                    <Button x:Name="DutyTitleBarToggleBtn" Style="{StaticResource TabletBtnStyle}" Height="28" Padding="10,2" Margin="0,0,10,0" Click="DutySidebarToggle_Click" ToolTip="Comută afișarea listei laterale de Medici la Datorie">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Ellipse x:Name="DutyTitleBarStatusDot" Width="7" Height="7" Fill="#94A3B8" VerticalAlignment="Center" Margin="0,0,6,0">
                                                <Ellipse.Effect>
                                                    <DropShadowEffect BlurRadius="4" Color="#94A3B8" ShadowDepth="0" Opacity="0.8"/>
                                                </Ellipse.Effect>
                                            </Ellipse>
                                            <TextBlock x:Name="DutyTitleBarToggleText" Text="Medici Duty" FontSize="11" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <!-- Network Status -->
                                    <TextBlock Text="5G MD" Foreground="#94a3b8" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Text="⚡ 100%" Foreground="#10b981" FontSize="11" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    <!-- Window Control buttons -->
                                    <Button Content="—" Width="24" Height="24" Background="Transparent" Foreground="#e2e8f0" BorderThickness="0" Margin="0,0,4,0" Focusable="False" Cursor="Hand" WindowChrome.IsHitTestVisibleInChrome="True" Click="MinimizeBtn_Click"/>
                                    <Button Content="✕" Width="24" Height="24" Background="Transparent" Foreground="#ef4444" BorderThickness="0" Focusable="False" Cursor="Hand" WindowChrome.IsHitTestVisibleInChrome="True" Click="CloseBtn_Click"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Row 1: Nav Toolbar -->
                        <Border Grid.Row="1" x:Name="NavToolbarBorder" Background="#F2121826" BorderBrush="#0FFFFFFF" BorderThickness="0,0,0,1" Padding="12,8" Visibility="Collapsed">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Column 0: Browser Nav Buttons -->
                                <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="0,0,10,0">
                                    <Button x:Name="BackBtn" Content="◀" ToolTip="Înapoi (sau Acasă)" Width="32" Height="32" Style="{StaticResource TabletBtnStyle}" Padding="0" Margin="0,0,4,0" Click="BackBtn_Click"/>
                                    <Button x:Name="ForwardBtn" Content="▶" ToolTip="Înainte" Width="32" Height="32" Style="{StaticResource TabletBtnStyle}" Padding="0" Margin="0,0,4,0" Click="ForwardBtn_Click"/>
                                    <Button x:Name="ReloadBtn" Content="⟳" ToolTip="Reîncarcă" Width="32" Height="32" Style="{StaticResource TabletBtnStyle}" Padding="0" Margin="0,0,4,0" Click="ReloadBtn_Click"/>
                                    <Button x:Name="HomeBtn" Content="🏠" ToolTip="Acasă (Desktop)" Width="32" Height="32" Style="{StaticResource TabletBtnStyle}" Padding="0" FontSize="15" FontFamily="Segoe UI Emoji, Segoe UI Symbol, Segoe UI" Click="HomeBtn_Click"/>
                                </StackPanel>

                                <!-- Column 1: URL input -->
                                <Grid Grid.Column="1" Margin="0,0,10,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="UrlTextBox" Grid.Column="0" Text="https://md.b-zone.ro" Style="{StaticResource UrlInputStyle}" KeyDown="UrlTextBox_KeyDown"/>
                                    <Button x:Name="GoBtn" Grid.Column="1" Content="➔" Width="32" Height="32" Margin="4,0,0,0" Style="{StaticResource TabletBtnStyle}" Click="GoBtn_Click"/>
                                </Grid>

                                <!-- Column 2: Quick Bookmarks -->
                                <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="0,0,10,0">
                                    <Button x:Name="MdPanelBtn" Content="BiSyS" Style="{StaticResource TabletBtnStyle}" Margin="0,0,4,0" Click="MdPanelBtn_Click"/>
                                    <Button x:Name="GtaPanelBtn" Content="Panel" Style="{StaticResource TabletBtnStyle}" Margin="0,0,4,0" Click="GtaPanelBtn_Click"/>
                                    <Button x:Name="WikiBtn" Content="Wiki" Style="{StaticResource TabletBtnStyle}" Click="WikiBtn_Click"/>
                                </StackPanel>

                                <!-- Column 3: Tools (Opacity, Zoom, Theme) -->
                                <StackPanel Grid.Column="3" Orientation="Horizontal">
                                    <!-- Opacity -->
                                    <TextBlock Text="🌓" Foreground="#94a3b8" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                    <Slider x:Name="OpacitySlider" Width="70" Minimum="0.5" Maximum="1.0" Value="0.96" VerticalAlignment="Center" Margin="0,0,4,0" ValueChanged="OpacitySlider_ValueChanged"/>
                                    <TextBlock x:Name="OpacityText" Text="96%" Foreground="#e2e8f0" VerticalAlignment="Center" Width="30" FontSize="11" Margin="0,0,10,0"/>

                                    <!-- Zoom -->
                                    <Button x:Name="ZoomOutBtn" Content="-" Width="24" Height="24" Style="{StaticResource TabletBtnStyle}" Click="ZoomOutBtn_Click"/>
                                    <TextBlock x:Name="ZoomText" Text="100%" Foreground="#e2e8f0" VerticalAlignment="Center" HorizontalAlignment="Center" TextAlignment="Center" Width="36" FontSize="11"/>
                                    <Button x:Name="ZoomInBtn" Content="+" Width="24" Height="24" Style="{StaticResource TabletBtnStyle}" Margin="0,0,10,0" Click="ZoomInBtn_Click"/>

                                    <!-- Theme Toggle -->
                                    <Button x:Name="ThemeBtn" Content="📱 Ramă" Style="{StaticResource TabletBtnStyle}" Click="ThemeBtn_Click"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Row 2: Main Content Area (Tablet Apps - Full Width) -->
                        <Grid Grid.Row="2">
                            <!-- Re-expand Tab on left edge of tablet screen (shown when sidebar is collapsed) -->
                            <Button x:Name="DutyExpandTabBtn" Content="◀" Width="18" Height="48" Style="{StaticResource TabletBtnStyle}" Background="#1C2436" Foreground="#00E5FF" BorderBrush="#334155" BorderThickness="0,1,1,1" Panel.ZIndex="99" HorizontalAlignment="Left" VerticalAlignment="Center" Click="DutySidebarExpandBtn_Click" ToolTip="Afișează lista de Medici la Datorie (în stânga)" Visibility="Visible"/>

                                <!-- DESKTOP GRID -->
                                <Grid x:Name="DesktopGrid" Visibility="Visible">
                                <Grid.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#0b0f19" Offset="0.0"/>
                                        <GradientStop Color="#1e1b4b" Offset="0.5"/>
                                        <GradientStop Color="#311042" Offset="1.0"/>
                                    </LinearGradientBrush>
                                </Grid.Background>
                                
                                <Image x:Name="DesktopWallpaperImage" Stretch="UniformToFill"/>
                                
                                <!-- Apps Grid -->
                                <Grid Margin="30,20">
                                    <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Top">
                                        <!-- BiSyS App (MD Panel) -->
                                        <Button Style="{StaticResource DesktopAppButtonStyle}" Margin="20" Width="100" Height="110" Click="BrowserMdApp_Click">
                                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Border CornerRadius="16" Width="68" Height="68" ClipToBounds="True">
                                                    <Border.Effect>
                                                        <DropShadowEffect BlurRadius="12" Color="Black" Opacity="0.5" ShadowDepth="3"/>
                                                    </Border.Effect>
                                                    <Image Source="/Assets/icon_mdpanel.png" Stretch="UniformToFill"/>
                                                </Border>
                                                <TextBlock Text="BiSyS" Foreground="White" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,8,0,0" TextAlignment="Center">
                                                    <TextBlock.Effect>
                                                        <DropShadowEffect BlurRadius="4" Color="Black" Opacity="0.9" ShadowDepth="1"/>
                                                    </TextBlock.Effect>
                                                </TextBlock>
                                            </StackPanel>
                                        </Button>
                                        
                                        <!-- Panel App (gta5.ro) -->
                                        <Button Style="{StaticResource DesktopAppButtonStyle}" Margin="20" Width="100" Height="110" Click="RpgPanelApp_Click">
                                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Border CornerRadius="16" Width="68" Height="68" ClipToBounds="True">
                                                    <Border.Effect>
                                                        <DropShadowEffect BlurRadius="12" Color="Black" Opacity="0.5" ShadowDepth="3"/>
                                                    </Border.Effect>
                                                    <Image Source="/Assets/icon_panel.png" Stretch="UniformToFill"/>
                                                </Border>
                                                <TextBlock Text="Panel" Foreground="White" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,8,0,0" TextAlignment="Center">
                                                    <TextBlock.Effect>
                                                        <DropShadowEffect BlurRadius="4" Color="Black" Opacity="0.9" ShadowDepth="1"/>
                                                    </TextBlock.Effect>
                                                </TextBlock>
                                            </StackPanel>
                                        </Button>

                                        <!-- Portal MAI App (mai.b-zone.ro) -->
                                        <Button Style="{StaticResource DesktopAppButtonStyle}" Margin="20" Width="100" Height="110" Click="MaiApp_Click">
                                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Border CornerRadius="16" Width="68" Height="68" ClipToBounds="True">
                                                    <Border.Effect>
                                                        <DropShadowEffect BlurRadius="12" Color="Black" Opacity="0.5" ShadowDepth="3"/>
                                                    </Border.Effect>
                                                    <Image Source="/Assets/icon_mai.png" Stretch="UniformToFill"/>
                                                </Border>
                                                <TextBlock Text="Portal MAI" Foreground="White" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,8,0,0" TextAlignment="Center">
                                                    <TextBlock.Effect>
                                                        <DropShadowEffect BlurRadius="4" Color="Black" Opacity="0.9" ShadowDepth="1"/>
                                                    </TextBlock.Effect>
                                                </TextBlock>
                                            </StackPanel>
                                        </Button>

                                        <!-- Gov App (gov.b-zone.ro) -->
                                        <Button Style="{StaticResource DesktopAppButtonStyle}" Margin="20" Width="100" Height="110" Click="GovApp_Click">
                                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Border CornerRadius="16" Width="68" Height="68" ClipToBounds="True">
                                                    <Border.Effect>
                                                        <DropShadowEffect BlurRadius="12" Color="Black" Opacity="0.5" ShadowDepth="3"/>
                                                    </Border.Effect>
                                                    <Image Source="/Assets/icon_primarie.png" Stretch="UniformToFill"/>
                                                </Border>
                                                <TextBlock Text="Portal Gov" Foreground="White" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,8,0,0" TextAlignment="Center">
                                                    <TextBlock.Effect>
                                                        <DropShadowEffect BlurRadius="4" Color="Black" Opacity="0.9" ShadowDepth="1"/>
                                                    </TextBlock.Effect>
                                                </TextBlock>
                                            </StackPanel>
                                        </Button>
                                        
                                        <!-- MDTab-Tools App (Keybinds & Overlays) -->
                                        <Button Style="{StaticResource DesktopAppButtonStyle}" Margin="20" Width="100" Height="110" Click="ToolsApp_Click">
                                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Border CornerRadius="16" Width="68" Height="68" ClipToBounds="True">
                                                    <Border.Effect>
                                                        <DropShadowEffect BlurRadius="12" Color="Black" Opacity="0.5" ShadowDepth="3"/>
                                                    </Border.Effect>
                                                    <Image Source="/Assets/icon_mdhelper.png" Stretch="UniformToFill"/>
                                                </Border>
                                                <TextBlock Text="MDTab-Tools" Foreground="White" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,8,0,0" TextAlignment="Center">
                                                    <TextBlock.Effect>
                                                        <DropShadowEffect BlurRadius="4" Color="Black" Opacity="0.9" ShadowDepth="1"/>
                                                    </TextBlock.Effect>
                                                </TextBlock>
                                            </StackPanel>
                                        </Button>

                                        <!-- Settings App -->
                                        <Button Style="{StaticResource DesktopAppButtonStyle}" Margin="20" Width="100" Height="110" Click="SettingsApp_Click">
                                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Border CornerRadius="16" Width="68" Height="68" ClipToBounds="True">
                                                    <Border.Effect>
                                                        <DropShadowEffect BlurRadius="12" Color="Black" Opacity="0.5" ShadowDepth="3"/>
                                                    </Border.Effect>
                                                    <Image Source="/Assets/icon_mdhelper.png" Stretch="UniformToFill"/>
                                                </Border>
                                                <TextBlock Text="Settings" Foreground="White" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,8,0,0" TextAlignment="Center">
                                                    <TextBlock.Effect>
                                                        <DropShadowEffect BlurRadius="4" Color="Black" Opacity="0.9" ShadowDepth="1"/>
                                                    </TextBlock.Effect>
                                                </TextBlock>
                                            </StackPanel>
                                        </Button>
                                    </WrapPanel>
                                </Grid>

                                <!-- Bottom Floating Dock -->
                                <Border VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,20" Height="80" Background="#44000000" BorderBrush="#15FFFFFF" BorderThickness="1" CornerRadius="20" Padding="15,5">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="15" Color="Black" Opacity="0.3" ShadowDepth="4"/>
                                    </Border.Effect>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Width="50" Height="50" Margin="8,0" Style="{x:Null}" Cursor="Hand" Click="BrowserMdApp_Click" ToolTip="BiSyS MD Panel">
                                            <Border CornerRadius="12" ClipToBounds="True">
                                                <Image Source="/Assets/icon_mdpanel.png" Stretch="UniformToFill"/>
                                            </Border>
                                        </Button>

                                        <Button Width="50" Height="50" Margin="8,0" Style="{x:Null}" Cursor="Hand" Click="RpgPanelApp_Click">
                                            <Border CornerRadius="12" ClipToBounds="True">
                                                <Image Source="/Assets/icon_panel.png" Stretch="UniformToFill"/>
                                            </Border>
                                        </Button>
                                        <Button Width="50" Height="50" Margin="8,0" Style="{x:Null}" Cursor="Hand" Click="ToolsApp_Click" ToolTip="MDTab-Tools (Keybinds &amp; Overlays)">
                                            <Border CornerRadius="12" ClipToBounds="True">
                                                <Image Source="/Assets/icon_mdhelper.png" Stretch="UniformToFill"/>
                                            </Border>
                                        </Button>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- WEB TAB CONTENT -->
                            <Grid x:Name="WebTabContent" Visibility="Collapsed">
                                <!-- Fallback/Loading screen -->
                                <Border x:Name="LoadingIndicator" Background="#0b0f17" Panel.ZIndex="1" Visibility="Visible">
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <ProgressBar IsIndeterminate="True" Width="200" Height="4" Background="#0DFFFFFF" Foreground="#ff2d55" BorderThickness="0"/>
                                        <TextBlock Text="Se încarcă tableta..." Foreground="#94a3b8" FontSize="12" Margin="0,10,0,0" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <wv2:WebView2 x:Name="TabletWebView"/>
                            </Grid>

                            <!-- TOOLS TAB CONTENT (MDTab-Tools: Keybinds &amp; Overlays) -->
                            <Grid x:Name="ToolsTabContent" Visibility="Collapsed" Background="#0f0f1a">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="210"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Left Sidebar Navigation -->
                                <Border Grid.Column="0" Background="#111122" BorderBrush="#1f1f38" BorderThickness="0,0,1,0" Padding="14,16">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="16"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <!-- Header &amp; Back Button -->
                                        <StackPanel Grid.Row="0">
                                            <Button Content="← Înapoi" ToolTip="Înapoi la ecranul principal (Desktop)" Style="{StaticResource TabletBtnStyle}" Background="#1E293B" Foreground="#00E5FF" BorderBrush="#334155" BorderThickness="1" Padding="10,6" Margin="0,0,0,14" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Click="HomeBtn_Click"/>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="2,0,0,0">
                                                <Border Background="#1A00E5FF" BorderBrush="#3300E5FF" BorderThickness="1" CornerRadius="8" Width="34" Height="34" Margin="0,0,10,0">
                                                    <TextBlock Text="🛠️" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="MDTab-Tools" FontSize="14.5" FontWeight="Bold" Foreground="White"/>
                                                    <TextBlock Text="Utilitare MDTab" FontSize="10.5" Foreground="#64748B"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- Navigation Buttons -->
                                        <StackPanel Grid.Row="2">
                                            <TextBlock Text="SECȚIUNI" Foreground="#475569" FontSize="10" FontWeight="ExtraBold" Margin="4,0,0,8"/>

                                            <!-- Keybinds Nav Button -->
                                            <Button x:Name="ToolsNavKeybindsBtn" Style="{StaticResource TabletBtnStyle}" Height="40" Padding="12,0" Margin="0,0,0,6" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Cursor="Hand" Click="ToolsNavKeybindsBtn_Click">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="⌨️" FontSize="14" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="Keybinds" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>

                                            <!-- Overlays Nav Button -->
                                            <Button x:Name="ToolsNavOverlaysBtn" Style="{StaticResource TabletBtnStyle}" Height="40" Padding="12,0" Margin="0,0,0,6" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Cursor="Hand" Click="ToolsNavOverlaysBtn_Click">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="🖼️" FontSize="14" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="Overlays" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>

                                        <!-- Footer Info Badge -->
                                        <Border Grid.Row="4" Background="#16162a" BorderBrush="#20203a" BorderThickness="1" CornerRadius="10" Padding="10">
                                            <StackPanel>
                                                <TextBlock Text="MDTab-Tools v2.7.4" Foreground="#94a3b8" FontSize="10.5" FontWeight="Bold"/>
                                                <TextBlock Text="Modificările se salvează automat." Foreground="#64748B" FontSize="9.5" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </Border>

                                <!-- Right Content Area -->
                                <Grid Grid.Column="1">
                                    <!-- 1. KEYBINDS VIEW -->
                                    <Grid x:Name="ToolsKeybindsView" Visibility="Visible">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>

                                        <!-- Header Area -->
                                        <Grid Grid.Row="0" Margin="20,16,20,12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="Keybinds Manager" FontSize="20" FontWeight="Bold" Foreground="White"/>
                                                <TextBlock Text="Configurează macro-uri și taste rapide" FontSize="11" Foreground="#64748B" Margin="0,2,0,0"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                <CheckBox x:Name="TabletGlobalKeybindsEnabledCheckBox" Content="Global Enabled" Foreground="#ccc" FontSize="13" VerticalAlignment="Center" Margin="0,0,15,0" Checked="TabletGlobalKeybinds_Checked" Unchecked="TabletGlobalKeybinds_Unchecked"/>
                                                <CheckBox x:Name="TabletGlobalSoundsEnabledCheckBox" Content="Enable Sounds" Foreground="#ccc" FontSize="13" VerticalAlignment="Center" Margin="0,0,15,0" Checked="TabletGlobalSounds_Checked" Unchecked="TabletGlobalSounds_Unchecked"/>
                                                <Button x:Name="TabletAddKeybindBtn" Content="➕ Adaugă Keybind" Style="{StaticResource TabletBtnStyle}" Padding="12,6" Click="TabletAddKeybindBtn_Click"/>
                                            </StackPanel>
                                        </Grid>

                                <Grid Grid.Row="1" Margin="20,0,20,20">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.5*"/>
                                        <ColumnDefinition Width="20"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Left: Keybinds List -->
                                    <Border Grid.Column="0" Background="#15152a" BorderBrush="#252540" BorderThickness="1" CornerRadius="12" Padding="15">
                                        <DataGrid x:Name="TabletKeybindsDataGrid"
                                                  AutoGenerateColumns="False"
                                                  CanUserAddRows="False"
                                                  CanUserDeleteRows="False"
                                                  GridLinesVisibility="None"
                                                  HeadersVisibility="Column"
                                                  Background="Transparent"
                                                  Foreground="White"
                                                  BorderThickness="0"
                                                  SelectionChanged="TabletKeybindsDataGrid_SelectionChanged"
                                                  Style="{StaticResource ModernDataGridStyle}">
                                            <DataGrid.ColumnHeaderStyle>
                                                <Style TargetType="DataGridColumnHeader">
                                                    <Setter Property="Background" Value="Transparent"/>
                                                    <Setter Property="Foreground" Value="#ccc"/>
                                                    <Setter Property="FontWeight" Value="Bold"/>
                                                    <Setter Property="FontSize" Value="13"/>
                                                    <Setter Property="Margin" Value="0,0,0,8"/>
                                                </Style>
                                            </DataGrid.ColumnHeaderStyle>
                                            <DataGrid.RowStyle>
                                                <Style TargetType="DataGridRow">
                                                    <Setter Property="Background" Value="Transparent"/>
                                                    <Setter Property="Foreground" Value="#ccc"/>
                                                    <Setter Property="FontSize" Value="12"/>
                                                    <Style.Triggers>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter Property="Background" Value="#4aff2d55"/>
                                                            <Setter Property="Foreground" Value="White"/>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </DataGrid.RowStyle>
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Nume" Binding="{Binding Name}" Width="*" IsReadOnly="True"/>
                                                <DataGridTextColumn Header="Tastă Trigger" Binding="{Binding KeyDisplay}" Width="120" IsReadOnly="True"/>
                                                <DataGridTemplateColumn Header="Activat" Width="60">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <CheckBox IsChecked="{Binding Enabled, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                      Click="TabletKeybindGridCheckBox_Click"/>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </Border>

                                    <!-- Right: Keybind Properties Panel & Delays -->
                                    <Border Grid.Column="2" Background="#15152a" BorderBrush="#252540" BorderThickness="1" CornerRadius="12" Padding="15">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                                            <StackPanel>
                                                <!-- Keybind Details -->
                                                <TextBlock Text="Proprietăți Keybind" FontSize="16" FontWeight="Bold" Foreground="White" Margin="0,0,0,10"/>
                                                
                                                <StackPanel x:Name="TabletKeybindPropertiesPanel" IsEnabled="False">
                                                    <TextBlock x:Name="TabletKeybindNoSelectionText" Text="Selectează un keybind din listă pentru a-l edita" FontSize="12" Foreground="#888" Margin="0,0,0,10" TextWrapping="Wrap"/>

                                                    <!-- Name -->
                                                    <TextBlock Text="Nume Keybind" Foreground="#ccc" FontSize="13" FontWeight="Bold" Margin="0,0,0,3"/>
                                                    <TextBox x:Name="TabletKeybindNameTextBox" Height="32" Style="{StaticResource ModernTextBoxStyle}" TextChanged="TabletKeybindNameTextBox_TextChanged" Margin="0,0,0,10"/>

                                                    <!-- Trigger Key -->
                                                    <TextBlock Text="Tastă Activare (Hotkey)" Foreground="#ccc" FontSize="13" FontWeight="Bold" Margin="0,0,0,3"/>
                                                    <Grid Margin="0,0,0,10">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Button x:Name="TabletRecordKeybindBtn" Grid.Column="0" Content="🔘 Set Key" Style="{StaticResource TabletBtnStyle}" Height="32" Padding="12,0" Click="TabletRecordKeybindBtn_Click"/>
                                                        <TextBlock x:Name="TabletKeybindKeyText" Grid.Column="1" Text="None" Foreground="#ff2d55" FontWeight="Bold" Margin="12,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                                    </Grid>

                                                    <!-- Script / Text -->
                                                    <TextBlock Text="Text / Comandă de trimis" Foreground="#ccc" FontSize="13" FontWeight="Bold" Margin="0,0,0,3"/>
                                                    <TextBox x:Name="TabletKeybindScriptTextBox" Height="60" AcceptsReturn="True" TextWrapping="Wrap" Style="{StaticResource ModernTextBoxStyle}" TextChanged="TabletKeybindScriptTextBox_TextChanged" Margin="0,0,0,10"/>

                                                    <!-- LER Compliance Warning Banner (Rule 2.27) -->
                                                    <Border x:Name="TabletKeybindScriptWarningBorder" Background="#26EF4444" BorderBrush="#EF4444" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,10" Visibility="Collapsed">
                                                        <StackPanel>
                                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                                <TextBlock Text="⛔" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                                <TextBlock Text="Regula 2.27 (Low Effort Roleplay)" Foreground="#EF4444" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                                                            </StackPanel>
                                                            <TextBlock x:Name="TabletKeybindScriptWarningText" Text="Comenzile automate pentru simularea recuperării din accident sunt interzise." Foreground="#FCA5A5" FontSize="11" TextWrapping="Wrap"/>
                                                        </StackPanel>
                                                    </Border>

                                                    <!-- Enabled checkbox -->
                                                    <CheckBox x:Name="TabletKeybindEnabledCheckBox" Content="Keybind activat" Foreground="#ccc" FontSize="12" Checked="TabletKeybindEnabledCheckBox_Checked" Unchecked="TabletKeybindEnabledCheckBox_Unchecked" Margin="0,0,0,15"/>

                                                    <!-- Delete Button -->
                                                    <Button x:Name="TabletRemoveKeybindBtn" Content="🗑️ Șterge Keybind" Style="{StaticResource TabletBtnStyle}" Background="#2Aef4444" Click="TabletRemoveKeybindBtn_Click" Margin="0,0,0,20"/>
                                                </StackPanel>

                                                <Separator Background="#252540" Height="1" Margin="0,10,0,15"/>

                                                <!-- Delays Settings -->
                                                <TextBlock Text="Timpi de întârziere (Delays)" FontSize="16" FontWeight="Bold" Foreground="White" Margin="0,0,0,10"/>
                                                
                                                <TextBlock Text="Cooldown între comenzi (ms):" Foreground="#ccc" FontSize="12" Margin="0,0,0,3"/>
                                                <TextBox x:Name="TabletDelayMsTextBox" Height="32" Style="{StaticResource ModernTextBoxStyle}" TextChanged="TabletDelays_TextChanged" Margin="0,0,0,8"/>

                                                <TextBlock Text="Întârziere după deschidere Chat (ms):" Foreground="#ccc" FontSize="12" Margin="0,0,0,3"/>
                                                <TextBox x:Name="TabletDelayChatOpenMsTextBox" Height="32" Style="{StaticResource ModernTextBoxStyle}" TextChanged="TabletDelays_TextChanged" Margin="0,0,0,8"/>

                                                <TextBlock Text="Întârziere după scriere Text (ms):" Foreground="#ccc" FontSize="12" Margin="0,0,0,3"/>
                                                <TextBox x:Name="TabletDelayTextMsTextBox" Height="32" Style="{StaticResource ModernTextBoxStyle}" TextChanged="TabletDelays_TextChanged" Margin="0,0,0,8"/>

                                                <TextBlock Text="Întârziere după tasta Enter (ms):" Foreground="#ccc" FontSize="12" Margin="0,0,0,3"/>
                                                <TextBox x:Name="TabletDelayEnterMsTextBox" Height="32" Style="{StaticResource ModernTextBoxStyle}" TextChanged="TabletDelays_TextChanged" Margin="0,0,0,12"/>

                                                <!-- Stop Hotkey -->
                                                <Grid Margin="0,5,0,0">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="5"/>
                                                        <RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>
                                                    <CheckBox x:Name="TabletStopHotkeyEnabledCheckBox" Grid.Row="0" Content="Tastă Oprire Forțată (Stop Key)" Foreground="#ccc" FontSize="12" Checked="TabletStopHotkey_Checked" Unchecked="TabletStopHotkey_Unchecked"/>
                                                    <Grid Grid.Row="2" Margin="0,0,0,10">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Button x:Name="TabletRecordStopKeyBtn" Grid.Column="0" Content="🔘 Set Key" Style="{StaticResource TabletBtnStyle}" Height="32" Padding="12,0" Click="TabletRecordStopKeyBtn_Click"/>
                                                        <TextBlock x:Name="TabletStopKeyText" Grid.Column="1" Text="None" Foreground="#ff2d55" FontWeight="Bold" Margin="12,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                                    </Grid>
                                                </Grid>
                                            </StackPanel>
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                                    </Grid>

                                    <!-- 2. OVERLAYS VIEW -->
                                    <Grid x:Name="ToolsOverlaysView" Visibility="Collapsed">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>

                                        <!-- Header Area -->
                                        <Grid Grid.Row="0" Margin="20,16,20,12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="Overlays Controller" FontSize="20" FontWeight="Bold" Foreground="White"/>
                                                <TextBlock Text="Gestionează imaginile și poziționarea pe ecran" FontSize="11" Foreground="#64748B" Margin="0,2,0,0"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button x:Name="TabletAddImageBtn" Content="➕ Adaugă Imagine" Style="{StaticResource TabletBtnStyle}" Padding="12,6" Click="TabletAddImageBtn_Click" Margin="0,0,8,0"/>
                                                <Button x:Name="TabletToggleOverlaysBtn" Content="👁️ Afișează / Ascunde Overlays" Style="{StaticResource TabletBtnStyle}" Padding="12,6" Click="TabletToggleOverlaysBtn_Click"/>
                                            </StackPanel>
                                        </Grid>

                                <Grid Grid.Row="1" Margin="20,0,20,20">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.5*"/>
                                        <ColumnDefinition Width="20"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Left: Images List -->
                                    <Border Grid.Column="0" Background="#15152a" BorderBrush="#252540" BorderThickness="1" CornerRadius="12" Padding="15">
                                        <DataGrid x:Name="TabletImagesDataGrid" Cursor="Hand"
                                                  AutoGenerateColumns="False"
                                                  CanUserAddRows="False"
                                                  CanUserDeleteRows="False"
                                                  GridLinesVisibility="None"
                                                  HeadersVisibility="Column"
                                                  Background="Transparent"
                                                  Foreground="White"
                                                  BorderThickness="0"
                                                  SelectionChanged="TabletImagesDataGrid_SelectionChanged"
                                                  Style="{StaticResource ModernDataGridStyle}">
                                            <DataGrid.ColumnHeaderStyle>
                                                <Style TargetType="DataGridColumnHeader">
                                                    <Setter Property="Background" Value="Transparent"/>
                                                    <Setter Property="Foreground" Value="#ccc"/>
                                                    <Setter Property="FontWeight" Value="Bold"/>
                                                    <Setter Property="FontSize" Value="13"/>
                                                    <Setter Property="Margin" Value="0,0,0,8"/>
                                                </Style>
                                            </DataGrid.ColumnHeaderStyle>
                                            <DataGrid.RowStyle>
                                                <Style TargetType="DataGridRow">
                                                    <Setter Property="Background" Value="Transparent"/>
                                                    <Setter Property="Foreground" Value="#ccc"/>
                                                    <Setter Property="FontSize" Value="12"/>
                                                    <Style.Triggers>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter Property="Background" Value="#4aff2d55"/>
                                                            <Setter Property="Foreground" Value="White"/>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </DataGrid.RowStyle>
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Nume" Binding="{Binding Name}" Width="*" IsReadOnly="True"/>
                                                <DataGridTextColumn Header="Mărime" Binding="{Binding SizeDisplay}" Width="100" IsReadOnly="True"/>
                                                <DataGridTemplateColumn Header="Locked" Width="60">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <CheckBox IsChecked="{Binding IsLocked, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                      Cursor="Hand"
                                                                      Click="TabletImageLockedGridCheckBox_Click"/>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>
                                                <DataGridTemplateColumn Header="Visible" Width="60">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <CheckBox IsChecked="{Binding IsVisible, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                      Cursor="Hand"
                                                                      Click="TabletImageVisibleGridCheckBox_Click"/>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </Border>

                                    <!-- Right: Properties Panel -->
                                    <Border Grid.Column="2" Background="#15152a" BorderBrush="#252540" BorderThickness="1" CornerRadius="12" Padding="15">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                                            <StackPanel x:Name="TabletPropertiesPanel" IsEnabled="False">
                                                <Grid Margin="0,0,0,10">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="Propriet&#x103;&#x21B;i Imagine" FontSize="16" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                                                    <Button x:Name="TabletUndoBtn" Grid.Column="1" Content="&#x21B6; Undo Modificare" Style="{StaticResource TabletBtnStyle}" Height="24" Padding="8,0" FontSize="11" Foreground="#38bdf8" BorderBrush="#0284c7" Click="TabletUndoBtn_Click" ToolTip="Anuleaz&#x103; ultima modificare de pozi&#x21B;ie/dimensiune/opacitate (Ctrl+Z)"/>
                                                </Grid>
                                                
                                                <TextBlock x:Name="TabletNoSelectionText" Text="Selectează o imagine din listă pentru a o edita" FontSize="12" Foreground="#888" Margin="0,0,0,10" TextWrapping="Wrap"/>

                                                <!-- Opacity -->
                                                <TextBlock Text="Opacitate" Foreground="#ccc" FontSize="13" FontWeight="Bold" Margin="0,0,0,3"/>
                                                <Grid Margin="0,0,0,10">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Slider x:Name="TabletImageOpacitySlider" Grid.Column="0" Minimum="0.1" Maximum="1.0" Value="1.0" TickFrequency="0.1" ValueChanged="TabletImageOpacitySlider_ValueChanged" PreviewMouseDown="ImageSlider_PreviewMouseDown" PreviewKeyDown="ImageSlider_PreviewKeyDown"/>
                                                    <TextBlock x:Name="TabletImageOpacityValueText" Grid.Column="1" Text="100%" Foreground="#ccc" FontSize="12" Margin="5,0,0,0" VerticalAlignment="Center"/>
                                                </Grid>

                                                <!-- Position -->
                                                <Grid Margin="0,0,0,4">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="Pozi&#x21B;ie pe Ecran (X, Y)" Foreground="#ccc" FontSize="13" FontWeight="Bold" VerticalAlignment="Center"/>
                                                    <Button x:Name="TabletCenterPositionBtn" Grid.Column="1" Content="&#x1F3AF; Centreaz&#x103; pe Ecran" Style="{StaticResource TabletBtnStyle}" Height="22" Padding="6,0" FontSize="10" Foreground="#a78bfa" Click="TabletCenterPositionBtn_Click" ToolTip="Readuce &#x219;i centreaz&#x103; imaginea pe monitorul principal"/>
                                                </Grid>
                                                
                                                <!-- Position X -->
                                                <Grid Margin="0,0,0,6">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="X:" Foreground="#94a3b8" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                    <Slider x:Name="TabletPosXSlider" Grid.Column="1" Minimum="0" Maximum="1920" Value="100" SmallChange="5" LargeChange="50" VerticalAlignment="Center" ValueChanged="TabletPosXSlider_ValueChanged" PreviewMouseDown="ImageSlider_PreviewMouseDown" PreviewKeyDown="ImageSlider_PreviewKeyDown"/>
                                                    <TextBox x:Name="TabletPosXTextBox" Grid.Column="2" Text="100" Width="70" Height="26" Margin="6,0,0,0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Style="{StaticResource ModernTextBoxStyle}" TextChanged="TabletPositionTextBox_TextChanged" GotFocus="ImageTextBox_GotFocus"/>
                                                </Grid>

                                                <!-- Position Y -->
                                                <Grid Margin="0,0,0,12">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="Y:" Foreground="#94a3b8" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                    <Slider x:Name="TabletPosYSlider" Grid.Column="1" Minimum="0" Maximum="1080" Value="100" SmallChange="5" LargeChange="50" VerticalAlignment="Center" ValueChanged="TabletPosYSlider_ValueChanged" PreviewMouseDown="ImageSlider_PreviewMouseDown" PreviewKeyDown="ImageSlider_PreviewKeyDown"/>
                                                    <TextBox x:Name="TabletPosYTextBox" Grid.Column="2" Text="100" Width="70" Height="26" Margin="6,0,0,0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Style="{StaticResource ModernTextBoxStyle}" TextChanged="TabletPositionTextBox_TextChanged" GotFocus="ImageTextBox_GotFocus"/>
                                                </Grid>

                                                <!-- Size -->
                                                <Grid Margin="0,0,0,4">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="Dimensiuni Imagine" Foreground="#ccc" FontSize="13" FontWeight="Bold" VerticalAlignment="Center"/>
                                                    <Button Grid.Column="1" Content="&#x21BA; Mărime Originală" Style="{StaticResource TabletBtnStyle}" Height="22" Padding="6,0" FontSize="10" Foreground="#00E5FF" Click="TabletResetSizeBtn_Click" ToolTip="Resetează lățimea și înălțimea la rezoluția nativă a imaginii"/>
                                                </Grid>

                                                <!-- Width / Single Dimension Slider -->
                                                <Grid x:Name="TabletImageWidthGrid" Margin="0,0,0,6">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock x:Name="TabletWidthLabel" Text="Dimensiune:" Foreground="#94a3b8" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                    <Slider x:Name="TabletImageWidthSlider" Grid.Column="1" Minimum="30" Maximum="3840" Value="200" SmallChange="5" LargeChange="50" VerticalAlignment="Center" ValueChanged="TabletImageWidthSlider_ValueChanged" PreviewMouseDown="ImageSlider_PreviewMouseDown" PreviewKeyDown="ImageSlider_PreviewKeyDown"/>
                                                    <TextBox x:Name="TabletImageWidthTextBox" Grid.Column="2" Text="200" Width="70" Height="26" Margin="6,0,0,0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Style="{StaticResource ModernTextBoxStyle}" TextChanged="TabletSizeTextBox_TextChanged" GotFocus="ImageTextBox_GotFocus"/>
                                                </Grid>

                                                <!-- Subtext showing full dimensions when single slider is active -->
                                                <TextBlock x:Name="TabletDimensionSubtext" Text="Dimensiune: 200 × 200 px" Foreground="#64748B" FontSize="11" Margin="2,0,0,6" Visibility="Collapsed"/>

                                                <!-- Height Slider (shown only when MaintainAspectRatio is unchecked) -->
                                                <Grid x:Name="TabletImageHeightGrid" Margin="0,0,0,10">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="Înălțime:" Foreground="#94a3b8" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                    <Slider x:Name="TabletImageHeightSlider" Grid.Column="1" Minimum="30" Maximum="3840" Value="200" SmallChange="5" LargeChange="50" VerticalAlignment="Center" ValueChanged="TabletImageHeightSlider_ValueChanged" PreviewMouseDown="ImageSlider_PreviewMouseDown" PreviewKeyDown="ImageSlider_PreviewKeyDown"/>
                                                    <TextBox x:Name="TabletImageHeightTextBox" Grid.Column="2" Text="200" Width="70" Height="26" Margin="6,0,0,0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Style="{StaticResource ModernTextBoxStyle}" TextChanged="TabletSizeTextBox_TextChanged" GotFocus="ImageTextBox_GotFocus"/>
                                                </Grid>
                                                <CheckBox x:Name="TabletMaintainAspectCheckBox" Content="Menține aspect ratio" Foreground="#ccc" FontSize="12" Checked="TabletMaintainAspectCheckBox_Checked" Unchecked="TabletMaintainAspectCheckBox_Unchecked" Margin="0,0,0,8"/>
                                                <CheckBox x:Name="TabletLockedCheckBox" Content="Locked (Click-through)" Foreground="#ccc" FontSize="12" Checked="TabletLockedCheckBox_Checked" Unchecked="TabletLockedCheckBox_Unchecked" Margin="0,0,0,8"/>
                                                <CheckBox x:Name="TabletVisibleCheckBox" Content="Vizibil pe ecran (Visible)" Foreground="#ccc" FontSize="12" Checked="TabletVisibleCheckBox_Checked" Unchecked="TabletVisibleCheckBox_Unchecked" Margin="0,0,0,15"/>

                                                <!-- Delete Button -->
                                                <Button x:Name="TabletRemoveImageBtn" Content="🗑️ Șterge Imagine" Style="{StaticResource TabletBtnStyle}" Background="#2Aef4444" Click="TabletRemoveImageBtn_Click"/>
                                            </StackPanel>
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                                    </Grid>
                                </Grid>
                            </Grid>
                            <!-- SETTINGS TAB CONTENT -->
                            <Grid x:Name="SettingsTabContent" Visibility="Collapsed" Background="#0f0f1a">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <!-- Header Area -->
                                <Grid Grid.Row="0" Margin="20,20,20,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Content="← Înapoi" ToolTip="Înapoi la ecranul principal (Desktop)" Style="{StaticResource TabletBtnStyle}" Background="#1E293B" Foreground="#00E5FF" BorderBrush="#334155" BorderThickness="1" Padding="10,4" Margin="0,0,14,0" Click="HomeBtn_Click" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="System &amp; Display Settings" FontSize="22" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                                </Grid>

                                <!-- Content Scroll Panel -->
                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="20,0,20,20">
                                    <StackPanel>
                                        <!-- Card 1: Windows Startup -->
                                        <Border Background="#15152a" BorderBrush="#252540" BorderThickness="1" CornerRadius="12" Padding="20" Margin="0,0,0,15">
                                            <Grid>
                                                <CheckBox x:Name="TabletStartWithWindowsCheckBox" Content="Start with Windows (Lansare automată la pornire PC)" Foreground="White" FontSize="14" FontWeight="Bold" Checked="TabletStartWithWindows_Checked" Unchecked="TabletStartWithWindows_Unchecked"/>
                                            </Grid>
                                        </Border>

                                        <!-- Card 2: Global Overlays Toggle Hotkey -->
                                        <Border Background="#15152a" BorderBrush="#252540" BorderThickness="1" CornerRadius="12" Padding="20" Margin="0,0,0,15">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="20"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="10"/>
                                                    <ColumnDefinition Width="100"/>
                                                    <ColumnDefinition Width="10"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <CheckBox x:Name="TabletOtEnabledCheckBox" Grid.Column="0" Content="Enable Overlay Toggle Hotkey" Foreground="White" FontSize="14" FontWeight="Bold" Checked="TabletOt_Checked" Unchecked="TabletOt_Unchecked"/>

                                                <TextBlock Grid.Column="2" Text="Hotkey:" Foreground="#ccc" FontSize="13" VerticalAlignment="Center"/>
                                                <Button x:Name="TabletRecordOtKeyBtn" Grid.Column="4" Content="🔴 Set Key" Height="32" Style="{StaticResource TabletBtnStyle}" Click="TabletRecordOtKeyBtn_Click"/>
                                                <TextBlock x:Name="TabletOtKeyText" Grid.Column="6" Text="None" Foreground="#ff2d55" FontWeight="Bold" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>

                                        <!-- Card 4: Copilot settings -->
                                        <Border Background="#15152a" BorderBrush="#252540" BorderThickness="1" CornerRadius="12" Padding="20" Margin="0,0,0,15">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="12"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>

                                                <CheckBox x:Name="TabletCopilotEnabledCheckBox" Grid.Row="0" Content="Enable Copilot (Pilot Automat / Auto-Hold)" Foreground="White" FontSize="14" FontWeight="Bold" Checked="TabletCopilot_Checked" Unchecked="TabletCopilot_Unchecked"/>

                                                <Grid Grid.Row="2">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="10"/>
                                                        <ColumnDefinition Width="100"/>
                                                        <ColumnDefinition Width="15"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="25"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="10"/>
                                                        <ColumnDefinition Width="100"/>
                                                        <ColumnDefinition Width="15"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock Grid.Column="0" Text="Tasta de menținut:" Foreground="#ccc" FontSize="13" VerticalAlignment="Center"/>
                                                    <Button x:Name="TabletRecordCopilotKeyBtn" Grid.Column="2" Content="🔴 Set Key" Height="32" Style="{StaticResource TabletBtnStyle}" Click="TabletRecordCopilotKeyBtn_Click"/>
                                                    <TextBlock x:Name="TabletCopilotKeyText" Grid.Column="4" Text="W" Foreground="#ff2d55" FontWeight="Bold" VerticalAlignment="Center"/>

                                                    <TextBlock Grid.Column="6" Text="Tasta activatoare:" Foreground="#ccc" FontSize="13" VerticalAlignment="Center"/>
                                                    <Button x:Name="TabletRecordCopilotTriggerBtn" Grid.Column="8" Content="🔴 Set Key" Height="32" Style="{StaticResource TabletBtnStyle}" Click="TabletRecordCopilotTriggerBtn_Click"/>
                                                    <TextBlock x:Name="TabletCopilotTriggerText" Grid.Column="10" Text="Ctrl" Foreground="#ff2d55" FontWeight="Bold" VerticalAlignment="Center"/>
                                                </Grid>
                                            </Grid>
                                        </Border>

                                        <!-- Card 5: Wallpaper Settings -->
                                        <Border Background="#15152a" BorderBrush="#252540" BorderThickness="1" CornerRadius="12" Padding="20" Margin="0,0,0,15">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="15"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>

                                                <!-- Row 0: Desktop Wallpaper -->
                                                <Grid Grid.Row="0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="160"/>
                                                        <ColumnDefinition Width="10"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="10"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="Desktop Wallpaper:" Foreground="White" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                                                    <Button x:Name="TabletSelectWallpaperBtn" Grid.Column="2" Content="🖼️ Schimbă Wallpaper" Style="{StaticResource TabletBtnStyle}" Height="32" Padding="12,4" Click="TabletSelectWallpaperBtn_Click"/>
                                                    <Button x:Name="TabletResetWallpaperBtn" Grid.Column="4" Content="🔄 Resetează Wallpaper" Style="{StaticResource TabletBtnStyle}" Height="32" Padding="12,4" Click="TabletResetWallpaperBtn_Click" HorizontalAlignment="Left" Margin="10,0,0,0"/>
                                                </Grid>

                                                <!-- Row 2: Lockscreen Wallpaper -->
                                                <Grid Grid.Row="2">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="160"/>
                                                        <ColumnDefinition Width="10"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="10"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="Lockscreen Wallpaper:" Foreground="White" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                                                    <Button x:Name="TabletSelectLockWallpaperBtn" Grid.Column="2" Content="🔒 Schimbă Lockscreen" Style="{StaticResource TabletBtnStyle}" Height="32" Padding="12,4" Click="TabletSelectLockWallpaperBtn_Click"/>
                                                    <Button x:Name="TabletResetLockWallpaperBtn" Grid.Column="4" Content="🔄 Resetează Lockscreen" Style="{StaticResource TabletBtnStyle}" Height="32" Padding="12,4" Click="TabletResetLockWallpaperBtn_Click" HorizontalAlignment="Left" Margin="10,0,0,0"/>
                                                </Grid>
                                            </Grid>
                                        </Border>

                                        <!-- Card: Auto-Update & Version -->
                                        <Border Background="#161b26" CornerRadius="12" Padding="16" Margin="0,0,0,14" BorderBrush="#1FFFFFFF" BorderThickness="1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="🚀 Versiune &amp; Actualizări:" Foreground="White" FontSize="14" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                                    <Border CornerRadius="4" Background="#1A00E5FF" Padding="6,2" VerticalAlignment="Center" Margin="0,0,10,0">
                                                        <TextBlock x:Name="SettingsCurrentVersionText" Text="v2.7.4" Foreground="#00E5FF" FontSize="11" FontWeight="Bold"/>
                                                    </Border>
                                                    <TextBlock x:Name="SettingsUpdateStatusText" Text="Verificare actualizări la pornire..." Foreground="#64748B" FontSize="12" VerticalAlignment="Center"/>
                                                </StackPanel>

                                                <Button x:Name="SettingsCheckUpdateBtn" Grid.Column="2" Content="⟳ Verifică Actualizări" Style="{StaticResource TabletBtnStyle}" Height="32" Padding="12,4" Click="SettingsCheckUpdateBtn_Click" Cursor="Hand"/>
                                            </Grid>
                                        </Border>

                                        <!-- Card: Feedback & Bug Report -->
                                        <Border Background="#161b26" CornerRadius="12" Padding="16" Margin="0,0,0,14" BorderBrush="#3300E5FF" BorderThickness="1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="Feedback &amp; Raportare Bug:" Foreground="White" FontSize="14" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                                        <Border CornerRadius="4" Background="#1A10B981" Padding="6,2" VerticalAlignment="Center">
                                                            <TextBlock Text="Direct pe Discord" Foreground="#10B981" FontSize="11" FontWeight="Bold"/>
                                                        </Border>
                                                    </StackPanel>
                                                    <TextBlock Text="Ai întâmpinat o problemă sau ai o sugestie? Trimite un raport rapid direct echipei noastre." Foreground="#94A3B8" FontSize="12" Margin="0,4,0,0"/>
                                                </StackPanel>

                                                <Button x:Name="TabletOpenFeedbackBtn" Grid.Column="2" Content="Raportează un Bug" Style="{StaticResource TabletBtnStyle}" Height="34" Padding="14,4" Background="#1A00E5FF" Foreground="#00E5FF" BorderBrush="#00E5FF" BorderThickness="1" Cursor="Hand" Click="TabletOpenFeedbackBtn_Click"/>
                                            </Grid>
                                        </Border>

                                        <!-- Card 5: Configuration Actions -->
                                        <Border Background="#161b26" CornerRadius="12" Padding="16" Margin="0,0,0,14" BorderBrush="#1FFFFFFF" BorderThickness="1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="20"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="10"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="20"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Grid.Column="0" Text="Configurare &amp; Sunete:" Foreground="White" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                                                <Button x:Name="TabletImportConfigBtn" Grid.Column="2" Content="📥 Importă Config" Style="{StaticResource TabletBtnStyle}" Height="32" Padding="12,4" Click="TabletImportConfigBtn_Click"/>
                                                <Button x:Name="TabletExportConfigBtn" Grid.Column="4" Content="📤 Exportă Config" Style="{StaticResource TabletBtnStyle}" Height="32" Padding="12,4" Click="TabletExportConfigBtn_Click" Margin="10,0,0,0"/>
                                                <Button x:Name="TabletExitAppBtn" Grid.Column="6" Content="❌ Închide Aplicația" Style="{StaticResource TabletBtnStyle}" Height="32" Padding="12,4" Click="TabletExitAppBtn_Click" Margin="10,0,0,0" Background="#33ef4444" BorderBrush="#ef4444"/>
                                            </Grid>
                                        </Border>
                                    </StackPanel>
                                </ScrollViewer>
                            </Grid>
                        </Grid>

                        <!-- Cookie Consent / Panel Sync Authorization Modal -->
                        <Grid x:Name="PanelSyncConsentModalGrid" Grid.RowSpan="4" Panel.ZIndex="160" Visibility="Collapsed">
                            <!-- Dimmed background overlay -->
                            <Border Background="#E0070B14" MouseLeftButtonDown="PanelSyncConsentCancel_Click"/>

                            <!-- Modal Card -->
                            <Border HorizontalAlignment="Center" VerticalAlignment="Center" Width="500" Background="#111622" BorderBrush="#00E5FF" BorderThickness="1" CornerRadius="18" Padding="24" ClipToBounds="True">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="40" Color="Black" Opacity="0.9" ShadowDepth="10"/>
                                </Border.Effect>
                                <StackPanel>
                                    <!-- Header with Shield Icon -->
                                    <Grid Margin="0,0,0,16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Width="42" Height="42" CornerRadius="10" Background="#16253B" BorderBrush="#00E5FF" BorderThickness="1" Margin="0,0,14,0" VerticalAlignment="Center">
                                            <TextBlock Text="🛡️" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="Autorizare Sincronizare Portal" Foreground="White" FontSize="16" FontWeight="Bold"/>
                                            <TextBlock Text="Acces securizat la datele tale de medic" Foreground="#00E5FF" FontSize="12" FontWeight="SemiBold" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <Button Grid.Column="2" Content="✕" Width="28" Height="28" Background="#182030" Foreground="#94A3B8" BorderThickness="0" Cursor="Hand" Click="PanelSyncConsentCancel_Click" VerticalAlignment="Top"/>
                                    </Grid>

                                    <!-- Explanation Box -->
                                    <Border Background="#090D15" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,16">
                                        <StackPanel>
                                            <TextBlock Text="Cum funcționează sincronizarea?" Foreground="#F1F5F9" FontSize="12.5" FontWeight="Bold" Margin="0,0,0,6"/>
                                            <TextBlock Text="Aplicația va citi sesiunea ta de conectare de pe portalul md.b-zone.ro (cookie-ul de autentificare) pentru a interoga direct și în timp real serverul Departamentului Medical." Foreground="#94A3B8" FontSize="11.5" TextWrapping="Wrap" LineHeight="16" Margin="0,0,0,10"/>

                                            <TextBlock Text="Ce date sunt sincronizate:" Foreground="#CBD5E1" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                            <TextBlock Text="• Colegii activi la datorie și gradul lor (pentru lista din panou)&#x0a;• Stocul de bandaje disponibile în depozitul facțiunii" Foreground="#38BDF8" FontSize="11" TextWrapping="Wrap" LineHeight="16" Margin="0,0,0,10"/>

                                            <Border Background="#0D1F18" BorderBrush="#10B981" BorderThickness="1" CornerRadius="6" Padding="10,6">
                                                <TextBlock Text="🔒 Confidențialitate 100%: Datele rămân exclusiv locale pe calculatorul tău. Nu colectăm parole, nu modificăm contul tău și nu trimitem date pe servere externe." Foreground="#34D399" FontSize="10.5" TextWrapping="Wrap" LineHeight="15"/>
                                            </Border>
                                        </StackPanel>
                                    </Border>

                                    <!-- Action Buttons -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <Button Grid.Column="1" Content="Anulează" Style="{StaticResource TabletBtnStyle}" Height="34" Padding="16,0" FontSize="12" FontWeight="SemiBold" Margin="0,0,10,0" Click="PanelSyncConsentCancel_Click"/>
                                        <Button Grid.Column="2" x:Name="PanelSyncConsentConfirmBtn" Content="✓ Activează Sincronizarea" Background="#00E5FF" Foreground="#0A0E17" Height="34" Padding="18,0" FontSize="12" FontWeight="Bold" Cursor="Hand" BorderThickness="0" Click="PanelSyncConsentConfirm_Click">
                                            <Button.Resources>
                                                <Style TargetType="Border">
                                                    <Setter Property="CornerRadius" Value="8"/>
                                                </Style>
                                            </Button.Resources>
                                        </Button>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Feedback & Bug Report Modal -->
                        <Grid x:Name="FeedbackModalGrid" Grid.RowSpan="4" Panel.ZIndex="170" Visibility="Collapsed">
                            <!-- Dimmed background overlay -->
                            <Border Background="#E0070B14" MouseLeftButtonDown="FeedbackCancel_Click"/>

                            <!-- Modal Card -->
                            <Border HorizontalAlignment="Center" VerticalAlignment="Center" Width="520" Background="#111622" BorderBrush="#00E5FF" BorderThickness="1" CornerRadius="18" Padding="24" ClipToBounds="True">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="40" Color="Black" Opacity="0.9" ShadowDepth="10"/>
                                </Border.Effect>
                                <StackPanel>
                                    <!-- Header -->
                                    <Grid Margin="0,0,0,16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Width="42" Height="42" CornerRadius="10" Background="#16253B" BorderBrush="#00E5FF" BorderThickness="1" Margin="0,0,14,0" VerticalAlignment="Center">
                                            <TextBlock Text="i" FontSize="20" FontWeight="Bold" Foreground="#00E5FF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="Raportează un Bug / Feedback" Foreground="White" FontSize="16" FontWeight="Bold"/>
                                            <TextBlock Text="Mesajul tău este trimis instant echipei de suport pe Discord" Foreground="#00E5FF" FontSize="12" FontWeight="SemiBold" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <Button Grid.Column="2" Content="✕" Width="28" Height="28" Background="#182030" Foreground="#94A3B8" BorderThickness="0" Cursor="Hand" Click="FeedbackCancel_Click" VerticalAlignment="Top"/>
                                    </Grid>

                                    <!-- Tip Raport -->
                                    <TextBlock Text="Tipul mesajului:" Foreground="#CBD5E1" FontSize="12.5" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                    <Grid Margin="0,0,0,14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="10"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="10"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <RadioButton x:Name="FeedbackTypeBugRadio" Grid.Column="0" Content="Bug / Problemă" IsChecked="True" Foreground="White" FontSize="12" GroupName="FeedbackTypeGroup"/>
                                        <RadioButton x:Name="FeedbackTypeSuggestionRadio" Grid.Column="2" Content="Sugestie" Foreground="White" FontSize="12" GroupName="FeedbackTypeGroup"/>
                                        <RadioButton x:Name="FeedbackTypeOtherRadio" Grid.Column="4" Content="Altceva" Foreground="White" FontSize="12" GroupName="FeedbackTypeGroup"/>
                                    </Grid>

                                    <!-- Autor (optional) -->
                                    <TextBlock Text="Nume sau Discord Tag (opțional):" Foreground="#CBD5E1" FontSize="12.5" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                    <TextBox x:Name="FeedbackAuthorTextBox" MaxLength="100" Height="34" Background="#161b26" Foreground="White" BorderBrush="#334155" BorderThickness="1" Padding="10,0" FontSize="12.5" VerticalContentAlignment="Center" Margin="0,0,0,14">
                                        <TextBox.Resources>
                                            <Style TargetType="Border">
                                                <Setter Property="CornerRadius" Value="8"/>
                                            </Style>
                                        </TextBox.Resources>
                                    </TextBox>

                                    <!-- Descriere detaliata -->
                                    <TextBlock Text="Descriere detaliată a problemei sau sugestiei:" Foreground="#CBD5E1" FontSize="12.5" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                    <TextBox x:Name="FeedbackDescTextBox" MaxLength="3500" Height="110" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Background="#161b26" Foreground="White" BorderBrush="#334155" BorderThickness="1" Padding="10,8" FontSize="12.5" Margin="0,0,0,10">
                                        <TextBox.Resources>
                                            <Style TargetType="Border">
                                                <Setter Property="CornerRadius" Value="8"/>
                                            </Style>
                                        </TextBox.Resources>
                                    </TextBox>

                                    <!-- Optiuni aditionale -->
                                    <CheckBox x:Name="FeedbackAttachDiagnosticsCheckBox" IsChecked="True" Content="Include automat versiunea MDTab-Helper și date de diagnostic" Foreground="#94A3B8" FontSize="11.5" Margin="0,0,0,14"/>

                                    <!-- Status Message (for success / error / progress) -->
                                    <TextBlock x:Name="FeedbackStatusText" Text="" Foreground="#10B981" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,12" Visibility="Collapsed"/>

                                    <!-- Actions -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="10"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Button Grid.Column="1" Content="Anulează" Style="{StaticResource TabletBtnStyle}" Height="34" Padding="16,0" FontSize="12" FontWeight="SemiBold" Click="FeedbackCancel_Click"/>
                                        <Button x:Name="FeedbackSubmitBtn" Grid.Column="3" Content="Trimite Raportul" Background="#00E5FF" Foreground="#0A0E17" Height="34" Padding="18,0" FontSize="12" FontWeight="Bold" Cursor="Hand" BorderThickness="0" Click="FeedbackSubmit_Click">
                                            <Button.Resources>
                                                <Style TargetType="Border">
                                                    <Setter Property="CornerRadius" Value="8"/>
                                                </Style>
                                            </Button.Resources>
                                        </Button>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Update Dialog Modal (Appears over tablet screen when update badge or button is clicked) -->
                        <Grid x:Name="UpdateModalGrid" Grid.RowSpan="4" Panel.ZIndex="150" Visibility="Collapsed">
                            <!-- Dimmed background overlay -->
                            <Border Background="#E0070B14"/>

                            <!-- Modal Card -->
                            <Border HorizontalAlignment="Center" VerticalAlignment="Center" Width="480" Background="#111622" BorderBrush="#00E5FF" BorderThickness="1" CornerRadius="18" Padding="24" ClipToBounds="True">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="40" Color="Black" Opacity="0.9" ShadowDepth="10"/>
                                </Border.Effect>
                                <StackPanel>
                                    <!-- Header -->
                                    <Grid Margin="0,0,0,16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="🚀" FontSize="26" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="Actualizare Disponibilă" Foreground="White" FontSize="16" FontWeight="Bold"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                                <TextBlock Text="Versiune nouă: " Foreground="#94A3B8" FontSize="12"/>
                                                <TextBlock x:Name="UpdateModalVersionText" Text="v2.6.0" Foreground="#00E5FF" FontSize="12" FontWeight="Bold" Margin="0,0,6,0"/>
                                                <TextBlock x:Name="UpdateModalSizeText" Text="(~73 MB)" Foreground="#64748B" FontSize="11" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </StackPanel>
                                        <Button Grid.Column="2" Content="✕" Width="26" Height="26" Style="{StaticResource TabletBtnStyle}" Padding="0" Cursor="Hand" Click="CancelUpdateBtn_Click"/>
                                    </Grid>

                                    <!-- Changelog Header -->
                                    <TextBlock Text="Noutăți și modificări:" Foreground="#CBD5E1" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                    <Border Background="#090D15" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="8" Padding="12" Height="130" Margin="0,0,0,16">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                                            <TextBlock x:Name="UpdateChangelogText" Text="Se încarcă detaliile..." Foreground="#94A3B8" FontSize="11" TextWrapping="Wrap" LineHeight="16"/>
                                        </ScrollViewer>
                                    </Border>

                                    <!-- Progress section (hidden until download starts) -->
                                    <StackPanel x:Name="UpdateProgressPanel" Visibility="Collapsed" Margin="0,0,0,16">
                                        <ProgressBar x:Name="UpdateProgressBar" Height="8" Minimum="0" Maximum="100" Value="0" Background="#161F30" Foreground="#00E5FF" BorderThickness="0"/>
                                        <TextBlock x:Name="UpdateProgressStatusText" Text="Se descarcă: 0%..." Foreground="#00E5FF" FontSize="11" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                                    </StackPanel>

                                    <!-- Action buttons -->
                                    <Grid x:Name="UpdateActionButtonsGrid">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="10"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="UpdateHintText" Grid.Column="0" Text="Aplicația se va reporni automat după descărcare." Foreground="#64748B" FontSize="10" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                        <Button x:Name="CancelUpdateBtn" Grid.Column="1" Content="Mai târziu" Style="{StaticResource TabletBtnStyle}" Height="34" Padding="14,6" Cursor="Hand" Click="CancelUpdateBtn_Click"/>
                                        <Button x:Name="ConfirmUpdateBtn" Grid.Column="3" Content="⚡ Actualizează acum" Style="{StaticResource TabletBtnStyle}" Background="#00E5FF" Foreground="#090D15" FontWeight="Bold" Height="34" Padding="16,6" Cursor="Hand" Click="ConfirmUpdateBtn_Click"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Lockscreen Overlay (Spans entire screen inside ScreenBorder) -->
                        <Grid x:Name="LockscreenGrid" Grid.RowSpan="4" Panel.ZIndex="100" Visibility="Visible" MouseLeftButtonDown="LockscreenGrid_MouseLeftButtonDown">
                            <!-- Gradient background overlay fallback -->
                            <Border>
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#090d16" Offset="0.0"/>
                                        <GradientStop Color="#16133a" Offset="0.5"/>
                                        <GradientStop Color="#250932" Offset="1.0"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                            <!-- Selected wallpaper as lockscreen background -->
                            <Image x:Name="LockscreenWallpaperImage" Stretch="UniformToFill"/>
                            <!-- Dimmed overlay -->
                            <Border Background="#A50A0E17"/>
                            
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <!-- Greeting -->
                                <TextBlock x:Name="LockscreenGreetingText" Text="Bună ziua, spor la muncă!" Foreground="#E2E8F0" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,12">
                                    <TextBlock.Effect>
                                        <DropShadowEffect BlurRadius="8" Color="Black" Opacity="0.6" ShadowDepth="1"/>
                                    </TextBlock.Effect>
                                </TextBlock>

                                <!-- Clock -->
                                <TextBlock x:Name="LockscreenClockText" Text="12:45" Foreground="White" FontSize="72" FontWeight="Light" HorizontalAlignment="Center" Margin="0,0,0,5">
                                    <TextBlock.Effect>
                                        <DropShadowEffect BlurRadius="10" Color="Black" Opacity="0.5" ShadowDepth="2"/>
                                    </TextBlock.Effect>
                                </TextBlock>
                                <!-- Date -->
                                <TextBlock x:Name="LockscreenDateText" Text="Luni, 17 August" Foreground="#cbd5e1" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,120">
                                    <TextBlock.Effect>
                                        <DropShadowEffect BlurRadius="6" Color="Black" Opacity="0.5" ShadowDepth="1"/>
                                    </TextBlock.Effect>
                                </TextBlock>
                                
                                <!-- Status/Hint -->
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <TextBlock Text="🔓" FontSize="18" Foreground="#ff2d55" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Click pentru a debloca tableta" Foreground="White" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center">
                                        <TextBlock.Effect>
                                            <DropShadowEffect BlurRadius="6" Color="Black" Opacity="0.8" ShadowDepth="1"/>
                                        </TextBlock.Effect>
                                    </TextBlock>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                        
                        <!-- Row 3: Bottom Bezel Indicator (Click to Close/Hide) -->
                        <Border Grid.Row="3" x:Name="BottomBar" Height="16" Background="#0b0f17" CornerRadius="0,0,18,18">
                            <Border x:Name="HomeIndicator" Width="140" Height="5" CornerRadius="2.5" Background="#334155" HorizontalAlignment="Center" VerticalAlignment="Center" Cursor="Hand" ToolTip="Acasă (Desktop)" MouseLeftButtonDown="HomeIndicator_MouseLeftButtonDown">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#ff2d55"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                            </Border>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
