<Window x:Class="MDHelper.Windows.TestWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Keybind Test"
        Height="300"
        Width="400"
        Background="#1a1a2e">
    
    <StackPanel Margin="20">
        <TextBlock Text="Keybind Test Window" 
                   FontSize="20" 
                   FontWeight="Bold" 
                   Foreground="White"
                   Margin="0,0,0,20"/>
        
        <TextBlock x:Name="StatusText" 
                   Text="Press F1 to test keybind..." 
                   FontSize="14" 
                   Foreground="#ccc"
                   Margin="0,0,0,20"/>
        
        <TextBox x:Name="TestTextBox" 
                 Height="100" 
                 Background="#0f0f1a" 
                 Foreground="White"
                 BorderBrush="#333"
                 TextWrapping="Wrap"
                 IsReadOnly="True"
                 VerticalScrollBarVisibility="Auto"/>
        
        <Button Content="Clear" 
                Click="ClearButton_Click"
                Background="#ff2d55"
                Foreground="White"
                BorderThickness="0"
                Padding="10,5"
                Margin="0,10,0,0"/>
    </StackPanel>
</Window>
