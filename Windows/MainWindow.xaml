<Window x:Class="MDHelper.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="MDTab-Helper"
        Height="700"
        Width="900"
        WindowStartupLocation="CenterScreen"
        Background="#0f0f1a">

    <Window.Resources>
        <!-- Modern Button Style -->
        <Style x:Key="ModernButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="#4aff2d55"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="500"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#ff2d55"/>
                    <Setter Property="BorderBrush" Value="#ff2d55"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Modern TextBox Style -->
        <Style x:Key="ModernTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="#1a1a2e"/>
            <Setter Property="BorderBrush" Value="#333333"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost" 
                                          Foreground="{TemplateBinding Foreground}"
                                          VerticalAlignment="Center"
                                          VerticalScrollBarVisibility="Disabled"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern DataGrid Style -->
        <Style x:Key="ModernDataGridStyle" TargetType="DataGrid">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="GridLinesVisibility" Value="None"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="RowBackground" Value="Transparent"/>
            <Setter Property="AlternatingRowBackground" Value="Transparent"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
            <Setter Property="SelectionMode" Value="Single"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0" 
                Background="#1a1a2e" 
                BorderBrush="#4aff2d55" 
                BorderThickness="0,0,1,0">
            <StackPanel Margin="20">
                <!-- Logo/Title -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,30">
                    <TextBlock Text="MD" 
                               FontSize="24" 
                               FontWeight="Bold" 
                               Foreground="#ff2d55"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="HELPER" 
                               FontSize="24" 
                               FontWeight="Bold" 
                               Foreground="White"
                               VerticalAlignment="Center"/>
                </StackPanel>
                
                <!-- Navigation Buttons -->
                <Button x:Name="AddImageBtn" 
                        Content="➕ Add Image" 
                        Click="AddImageBtn_Click"
                        Style="{StaticResource ModernButtonStyle}"/>
                
                <Button x:Name="ToggleOverlayBtn" 
                        Content="👁️ Show Overlays" 
                        Click="ToggleOverlayBtn_Click"
                        Style="{StaticResource ModernButtonStyle}"/>

                <Button x:Name="KeybindBtn" 
                        Content="⌨️ Keybinds" 
                        Click="KeybindBtn_Click"
                        Style="{StaticResource ModernButtonStyle}"/>

                <Button x:Name="WindowToggleBtn" 
                        Content="🌐 Display &amp; Tablet" 
                        Click="WindowToggleBtn_Click"
                        Style="{StaticResource ModernButtonStyle}"/>

                <Button x:Name="TabletToggleBtn" 
                        Content="📱 Tablet Overlay" 
                        Click="TabletToggleBtn_Click"
                        Style="{StaticResource ModernButtonStyle}"/>

                <Button x:Name="ImportBtn" 
                        Content="📥 Import Config" 
                        Click="ImportBtn_Click"
                        Style="{StaticResource ModernButtonStyle}"/>
                
                <Button x:Name="ExportBtn" 
                        Content="📤 Export Config" 
                        Click="ExportBtn_Click"
                        Style="{StaticResource ModernButtonStyle}"/>

                <Button x:Name="MuteBtn" 
                        Content="🔊 Sounds: Enabled" 
                        Click="MuteBtn_Click"
                        Style="{StaticResource ModernButtonStyle}"/>

                <!-- Status -->
                <TextBlock x:Name="StatusText" 
                           Text="Ready" 
                           FontSize="12" 
                           Foreground="#666"
                           Margin="0,30,0,0"
                           TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <!-- Main Content -->
        <Grid Grid.Column="1" Background="#0f0f1a">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <TextBlock Grid.Row="0" 
                       Text="Overlays Controller" 
                       FontSize="28" 
                       FontWeight="900" 
                       Foreground="White"
                       Margin="0,0,0,20"/>

            <!-- Content Area with two columns -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.5*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Images List -->
                <Border Grid.Column="0" 
                        Background="#1a1a2e" 
                        BorderBrush="#333333" 
                        BorderThickness="1" 
                        CornerRadius="12" 
                        Padding="20">
                    <DataGrid x:Name="ImagesDataGrid"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              GridLinesVisibility="None"
                              HeadersVisibility="Column"
                              Background="Transparent"
                              Foreground="White"
                              BorderThickness="0"
                              SelectionChanged="ImagesDataGrid_SelectionChanged"
                              Style="{StaticResource ModernDataGridStyle}">
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Foreground" Value="#ccc"/>
                                <Setter Property="FontWeight" Value="800"/>
                                <Setter Property="FontSize" Value="14"/>
                                <Setter Property="Margin" Value="0,0,0,10"/>
                                <Setter Property="Padding" Value="0,5,0,5"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Foreground" Value="#ccc"/>
                                <Setter Property="FontSize" Value="13"/>
                                <Setter Property="Margin" Value="0,2"/>
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="#4aff2d55"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*"/>
                            <DataGridTextColumn Header="Size" Binding="{Binding SizeDisplay}" Width="120"/>
                            <DataGridCheckBoxColumn Header="Locked" Binding="{Binding IsLocked}" Width="60"/>
                            <DataGridCheckBoxColumn Header="Visible" Binding="{Binding IsVisible}" Width="60"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>

                <!-- Properties Panel -->
                <Border Grid.Column="2" 
                        Background="#1a1a2e" 
                        BorderBrush="#333333" 
                        BorderThickness="1" 
                        CornerRadius="12" 
                        Padding="20">
                    <StackPanel x:Name="PropertiesPanel" IsEnabled="False">
                        <TextBlock Text="Properties" 
                                   FontSize="18" 
                                   FontWeight="800" 
                                   Foreground="White"
                                   Margin="0,0,0,15"/>
                        
                        <TextBlock x:Name="NoSelectionText" 
                                   Text="Select an image to edit properties" 
                                   FontSize="13" 
                                   Foreground="#666"
                                   Margin="0,0,0,10"/>
                        
                        <!-- Opacity -->
                        <TextBlock Text="Opacity" 
                                   Foreground="#ccc" 
                                   FontSize="14" 
                                   FontWeight="800"
                                   Margin="0,0,0,5"/>
                        <Grid Margin="0,0,0,15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Slider x:Name="OpacitySlider"
                                    Grid.Column="0"
                                    Minimum="0.1"
                                    Maximum="1.0"
                                    Value="1.0"
                                    TickFrequency="0.1"
                                    ValueChanged="OpacitySlider_ValueChanged"/>
                            <TextBlock x:Name="OpacityValueText" 
                                       Grid.Column="1" 
                                       Text="100%" 
                                       Foreground="#ccc" 
                                       FontSize="13" 
                                       VerticalAlignment="Center" 
                                       Margin="5,0,0,0"/>
                        </Grid>

                        <!-- Position -->
                        <TextBlock Text="Position" 
                                   Foreground="#ccc" 
                                   FontSize="14" 
                                   FontWeight="800"
                                   Margin="0,0,0,5"/>
                        <Grid Margin="0,0,0,15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="PosXTextBox" 
                                     Grid.Column="0" 
                                     Text="0" 
                                     Style="{StaticResource ModernTextBoxStyle}"
                                     TextChanged="PositionTextBox_TextChanged"/>
                            <TextBox x:Name="PosYTextBox" 
                                     Grid.Column="2" 
                                     Text="0" 
                                     Style="{StaticResource ModernTextBoxStyle}"
                                     TextChanged="PositionTextBox_TextChanged"/>
                        </Grid>

                        <!-- Size -->
                        <TextBlock Text="Size" 
                                   Foreground="#ccc" 
                                   FontSize="14" 
                                   FontWeight="800"
                                   Margin="0,0,0,5"/>
                        <Grid Margin="0,0,0,15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="WidthTextBox" 
                                     Grid.Column="0" 
                                     Text="100" 
                                     Style="{StaticResource ModernTextBoxStyle}"
                                     TextChanged="SizeTextBox_TextChanged"/>
                            <TextBox x:Name="HeightTextBox" 
                                     Grid.Column="2" 
                                     Text="100" 
                                     Style="{StaticResource ModernTextBoxStyle}"
                                     TextChanged="SizeTextBox_TextChanged"/>
                        </Grid>

                        <!-- Options -->
                        <CheckBox x:Name="MaintainAspectCheckBox" 
                                  Content="Maintain Aspect Ratio" 
                                  Foreground="#ccc" 
                                  FontSize="13"
                                  Checked="MaintainAspectCheckBox_Checked"
                                  Unchecked="MaintainAspectCheckBox_Unchecked"
                                  Margin="0,0,0,10"/>
                        
                        <CheckBox x:Name="LockedCheckBox" 
                                  Content="Locked (Click-through)" 
                                  Foreground="#ccc" 
                                  FontSize="13"
                                  Checked="LockedCheckBox_Checked"
                                  Unchecked="LockedCheckBox_Unchecked"/>

                        <!-- Actions -->
                        <Button x:Name="RemoveImageBtn" 
                                Content="🗑️ Remove Image" 
                                Click="RemoveImageBtn_Click"
                                Style="{StaticResource ModernButtonStyle}"
                                Margin="0,20,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
